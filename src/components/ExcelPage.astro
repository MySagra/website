---
import '@fontsource/inter/600.css';
import '@fontsource/inter/700.css';
import '@fontsource/work-sans/400.css';
import '@fontsource/work-sans/500.css';
import '@fontsource/work-sans/600.css';
import '../styles/global.css';
import Header from './Header.astro';
import Footer from './Footer.astro';
import ContactModal from './ContactModal.astro';
import Analytics from './Analytics.astro';
import { getExcelContent } from '../i18n/excel';
import type { Lang } from '../i18n/ui';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = getExcelContent(lang);
const home = lang === 'en' ? '/en/' : '/';
const site = 'https://mysagra.com';
const slug = 'festival-management-excel/';
const canonical = `${site}${home}${slug}`;
const image = `${site}/images/mycassa-terminal.webp`;
const sheets = [
  {
    id: 'orders',
    headers: ['Data/Ora', 'Ricavo Totale', 'Ricavo Contanti', 'Ricavo Carta', 'Ordini Totali', 'Tempo Medio Completamento (min)'],
    rows: [
      ['19/10/2026, 23:00:00', '3.480,00 €', '2.080,00 €', '1.400,00 €', '180', '12'],
      ['20/10/2026, 23:00:00', '4.320,00 €', '2.520,00 €', '1.800,00 €', '216', '14'],
    ],
    total: ['TOTALE', '7.800,00 €', '4.600,00 €', '3.200,00 €', '396', '—'],
  },
  {
    id: 'dishes', headers: ['Nome', 'Quantità'],
    rows: [['Casoncelli', '160'], ['Polenta con formaggio', '130'], ['Panino con salamella', '96']],
    total: null,
  },
  {
    id: 'tills', headers: ['Cassa', 'Ricavo Totale', 'Ricavo Contanti', 'Ricavo Carta'],
    rows: [['Cassa 1', '4.100,00 €', '2.400,00 €', '1.700,00 €'], ['Cassa 2', '3.700,00 €', '2.200,00 €', '1.500,00 €']],
    total: ['TOTALE', '7.800,00 €', '4.600,00 €', '3.200,00 €'],
  },
];
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'Organization', '@id': `${site}/#organization`, name: 'MySagra', url: `${site}/`, logo: `${site}/favicon.svg` },
    { '@type': 'WebPage', '@id': `${canonical}#webpage`, url: canonical, name: t.title, description: t.description, inLanguage: lang, publisher: { '@id': `${site}/#organization` }, breadcrumb: { '@id': `${canonical}#breadcrumb` } },
    { '@type': 'BreadcrumbList', '@id': `${canonical}#breadcrumb`, itemListElement: [{ '@type': 'ListItem', position: 1, name: 'MySagra', item: `${site}${home}` }, { '@type': 'ListItem', position: 2, name: t.breadcrumb, item: canonical }] },
    { '@type': 'FAQPage', '@id': `${canonical}#faq`, isPartOf: { '@id': `${canonical}#webpage` }, inLanguage: lang, mainEntity: t.faq.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) },
  ],
};
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.title}</title>
    <meta name="description" content={t.description} />
    <meta name="theme-color" content="#FECC01" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="it" href={`${site}/${slug}`} />
    <link rel="alternate" hreflang="en" href={`${site}/en/${slug}`} />
    <link rel="alternate" hreflang="x-default" href={`${site}/${slug}`} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="MySagra" />
    <meta property="og:title" content={t.title} />
    <meta property="og:description" content={t.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'it_IT'} />
    <meta property="og:locale:alternate" content={lang === 'en' ? 'it_IT' : 'en_US'} />
    <meta property="og:image" content={image} />
    <meta property="og:image:alt" content={t.photoAlt} />
    <meta property="og:image:width" content="2400" />
    <meta property="og:image:height" content="1601" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={t.title} />
    <meta name="twitter:description" content={t.description} />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:image:alt" content={t.photoAlt} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />
    <Analytics lang={lang} />
  </head>
  <body>
    <a class="skip-link" href="#main">{lang === 'en' ? 'Skip to content' : 'Vai al contenuto'}</a>
    <Header lang={lang} />
    <main id="main">
      <div class="container">
        <nav class="breadcrumb" aria-label="Breadcrumb"><a href={home}>MySagra</a><span aria-hidden="true">/</span><span aria-current="page">{t.breadcrumb}</span></nav>
        <section class="hero" aria-labelledby="hero-title">
          <h1 id="hero-title">{t.headline}<br /><span>{t.headlineEnd}</span></h1>
          <p>{t.intro}</p>
          <div class="buttons">
            <button class="btn primary" type="button" data-open-contact="informazioni" data-request-type="demo" data-umami-event="contact-open" data-umami-event-location="excel-hero">{t.demo}</button>
            <a class="btn secondary" href="#report" data-umami-event="excel-report-explore">{t.seeReport}<svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 4v16m-6-6 6 6 6-6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg></a>
          </div>
        </section>
        <section id="report" class="report" aria-labelledby="report-title">
          <div class="report-heading"><h2 id="report-title">{t.reportTitle}</h2><span class="example">{t.example}</span></div>
          <p class="report-intro">{t.reportIntro}</p>
          <div class="workbook">
            <div class="workbook-bar"><svg width="21" height="21" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2" stroke="currentColor" stroke-width="1.5" /><path d="M3 9h18M3 15h18M9 3v18" stroke="currentColor" stroke-width="1.5" /></svg><span>report_2026-10-19_2026-10-20.xlsx</span><span class="filetype">.xlsx</span></div>
            <div class="sheet-links" aria-label={t.sheetLabel}>
              {sheets.map((sheet, index) => <button type="button" id={`tab-${sheet.id}`} data-sheet-tab={sheet.id} data-umami-event="excel-sheet-select" data-umami-event-sheet={sheet.id}>{t.sheets[index][0]}</button>)}
            </div>
            <div class="sheet-panels">
            {sheets.map((sheet, index) => <section class="sheet-panel" id={`sheet-${sheet.id}`} aria-labelledby={`sheet-title-${sheet.id}`}>
              <h3 id={`sheet-title-${sheet.id}`}>{t.sheets[index][0]}</h3>
              <p class="sheet-description">{t.sheets[index][1]}</p>
              <div class="table-scroll" tabindex="0" role="region" aria-labelledby={`sheet-title-${sheet.id}`} aria-describedby="table-hint">
                <table class:list={['report-table', { 'report-table--orders': sheet.id === 'orders' }]}>
                  <caption class="sr-only">{t.sheets[index][0]} — {t.example}</caption>
                  <thead><tr>{sheet.headers.map((header) => <th scope="col">{header}</th>)}</tr></thead>
                  <tbody>{sheet.rows.map((row) => <tr>{row.map((cell, col) => col === 0 ? <th scope="row">{cell}</th> : <td>{cell}</td>)}</tr>)}</tbody>
                  {sheet.total && <tfoot><tr>{sheet.total.map((cell, col) => col === 0 ? <th scope="row">{cell}</th> : <td>{cell}</td>)}</tr></tfoot>}
                </table>
              </div>
            </section>)}
            </div>
            <p id="table-hint" class="table-hint">{t.scroll}</p>
          </div>
          <p class="report-note">{t.reportNote}</p>
        </section>
      </div>
      <section class="section warm" aria-labelledby="limits-title">
        <div class="container">
          <div class="section-head"><h2 id="limits-title">{t.limitsTitle}</h2><p>{t.limitsIntro}</p></div>
          <div class="comparison-scroll" tabindex="0" role="region" aria-labelledby="limits-title">
            <table class="comparison"><thead><tr>{t.compareHeaders.map((header) => <th scope="col">{header}</th>)}</tr></thead><tbody>{t.comparison.map(([task, excel, mysagra]) => <tr><th scope="row">{task}</th><td><span class="compare-label" aria-hidden="true">{t.compareHeaders[1]}</span>{excel}</td><td><span class="compare-label" aria-hidden="true">{t.compareHeaders[2]}</span>{mysagra}</td></tr>)}</tbody></table>
          </div>
          <p class="limits-note">{t.limitsNote}</p>
        </div>
      </section>
      <section class="section" aria-labelledby="operations-title">
        <div class="container operations-grid">
          <div><h2 id="operations-title">{t.operationsTitle}</h2><p class="section-intro">{t.operationsIntro}</p>
            <dl class="features">{t.features.map(([title, copy]) => <div><dt>{title}</dt><dd>{copy}</dd></div>)}</dl>
            <a class="text-link" href={`${home}#ecosystem`}>{t.ecosystemLink}</a>
          </div>
          <figure class="product"><img src="/images/mycassa-terminal.webp" alt={t.photoAlt} width="2400" height="1601" loading="lazy" decoding="async" /><figcaption>{t.photoCaption}</figcaption></figure>
        </div>
      </section>
      <section class="section warm" aria-labelledby="workflow-title">
        <div class="container">
          <div class="section-head"><h2 id="workflow-title">{t.workflowTitle}</h2><p>{t.workflowIntro}</p></div>
          <ol class="workflow">{t.workflow.map(([title, copy], index) => <li><span class="step" aria-hidden="true">{index + 1}</span><h3>{title}</h3><p>{copy}</p></li>)}</ol>
        </div>
      </section>
      <section class="section" aria-labelledby="faq-title">
        <div class="container faq-grid"><h2 id="faq-title">{t.faqTitle}</h2><div>{t.faq.map(([q, a]) => <details><summary>{q}</summary><p>{a}</p></details>)}</div></div>
      </section>
      <section class="closing">
        <div class="container"><h2>{t.closingTitle}</h2><p>{t.closingCopy}</p><div class="buttons"><button class="btn primary" type="button" data-open-contact="informazioni" data-request-type="demo" data-umami-event="contact-open" data-umami-event-location="excel-closing">{t.demo}</button><a class="btn dark-secondary" href={`${home}#solutions`} data-umami-event="excel-plans-click">{t.plans}</a></div></div>
      </section>
    </main>
    <Footer lang={lang} />
    <ContactModal lang={lang} defaultSubject={t.subject} />
  </body>
</html>

<style>
  :global(body) { background: var(--color-surface); }
  .container { max-width: 71rem; padding-inline: 1.5rem; margin-inline: auto; }
  a { text-underline-offset: .22em; }
  .skip-link { position: fixed; top: -6rem; left: 1rem; z-index: 100; padding: .75rem; background: var(--color-yellow); }
  .skip-link:focus { top: 1rem; }
  .breadcrumb { display: flex; flex-wrap: wrap; gap: .75rem; font-size: .85rem; padding-top: 1.8rem; color: #52565e; }
  .hero { padding-block: 3.5rem 3rem; text-align: center; }
  h1 { font-size: clamp(2.3rem, 4.8vw, 3.75rem); line-height: 1.1; }
  .hero > p { max-width: 67ch; margin: 1.5rem auto 0; font-size: 1.14rem; color: #454950; }
  .buttons { display: flex; flex-wrap: wrap; justify-content: center; gap: .8rem; margin-top: 1.8rem; }
  .btn { display: inline-flex; align-items: center; justify-content: center; gap: .65rem; min-height: 48px; padding: .9rem 1.45rem; border: 1px solid transparent; border-radius: var(--radius-pill); font-size: .95rem; font-weight: 600; text-decoration: none; cursor: pointer; transition: transform .2s, box-shadow .2s, border-color .2s; }
  .primary { background: var(--color-yellow); color: var(--color-ink); }
  .secondary { background: var(--color-surface); border-color: var(--color-neutral-200); }
  .btn:hover { transform: translateY(-1px); box-shadow: var(--shadow-soft); }
  .secondary:hover { border-color: var(--color-ink); }
  h2 { font-size: clamp(1.8rem, 3.1vw, 2.5rem); line-height: 1.15; }
  h3 { font-size: 1.15rem; line-height: 1.25; }
  .report { padding-bottom: 4.5rem; scroll-margin-top: 6rem; }
  .report-heading { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 1rem; align-items: center; }
  .report-heading h2 { font-size: clamp(1.35rem, 2.4vw, 1.7rem); }
  .example { display: inline-flex; align-items: center; background: #fff4c5; border-radius: var(--radius-pill); padding: .35rem .8rem; font-size: .8rem; font-weight: 600; }
  .report-intro { margin-block: .8rem 1.4rem; font-size: 1rem; color: #454950; max-width: 75ch; }
  .workbook { border: 1px solid var(--color-neutral-200); border-radius: var(--radius-lg); box-shadow: var(--shadow-lifted); overflow: clip; }
  .workbook-bar { display: flex; align-items: center; gap: .7rem; padding: 1rem 1.4rem; background: var(--color-surface-warm); border-bottom: 1px solid var(--color-neutral-200); font-size: .85rem; font-weight: 600; }
  .workbook-bar svg { flex-shrink: 0; }
  .workbook-bar > span:first-of-type { overflow-wrap: anywhere; }
  .filetype { margin-left: auto; color: #52565e; font-weight: 400; }
  .sheet-links { display: none; flex-wrap: wrap; gap: .25rem; padding: .65rem 1.1rem 0; border-bottom: 1px solid var(--color-neutral-200); }
  .workbook[data-enhanced] .sheet-links { display: flex; }
  .sheet-links button { background: transparent; border: 0; font: inherit; cursor: pointer; display: block; padding: .8rem .9rem; min-height: 48px; text-decoration: none; font-size: .88rem; color: #454950; border-bottom: 3px solid transparent; }
  .sheet-links button:hover { background: var(--color-surface-warm); color: var(--color-ink); }
  .sheet-links button[aria-selected='true'] { color: var(--color-ink); font-weight: 600; border-bottom-color: var(--color-yellow); }
  .sheet-links button:focus-visible { outline-offset: -3px; }
  .sheet-panel { padding: 1.3rem 1.4rem 0; scroll-margin-top: 6rem; }
  .workbook[data-enhanced] .sheet-panels { display: grid; }
  .workbook[data-enhanced] .sheet-panel { grid-area: 1 / 1; min-width: 0; }
  .workbook[data-enhanced] .sheet-panel[hidden] { display: block; visibility: hidden; pointer-events: none; }
  .sheet-description { color: #52565e; font-size: .9rem; margin-bottom: 1.1rem; }
  .sheet-panel h3 { font-size: 1rem; margin-bottom: .5rem; }
  .workbook[data-enhanced] .sheet-panel h3 { display: none; }
  .table-scroll, .comparison-scroll { overflow-x: auto; scrollbar-color: #6b7280 #f3f3f0; scrollbar-width: thin; }
  .table-scroll:focus-visible { outline-offset: -3px; }
  table { width: 100%; border-collapse: collapse; font-variant-numeric: tabular-nums; }
  .report-table { font-size: .86rem; min-width: 380px; }
  .report-table--orders { min-width: 940px; }
  .report-table th, .report-table td { padding: .95rem .8rem; border-bottom: 1px solid var(--color-neutral-200); text-align: right; }
  .report-table th:first-child { text-align: left; }
  .report-table thead th { background: var(--color-surface-warm); font-size: .8rem; font-weight: 600; vertical-align: middle; }
  .report-table tbody th { font-weight: 400; white-space: nowrap; }
  .report-table td { white-space: nowrap; }
  .report-table tfoot { font-weight: 600; background: #fff9e5; }
  .report-table tbody tr:hover { background: var(--color-surface-warm); }
  .table-hint { padding: .85rem 1.4rem; color: #52565e; font-size: .78rem; }
  .report-note { margin-top: 1.4rem; color: #52565e; font-size: .82rem; max-width: 94ch; }
  .section { padding-block: 5.5rem; }
  .warm { background: var(--color-surface-warm); }
  .section-head { max-width: 48rem; margin-bottom: 2.5rem; }
  .section-head p, .section-intro { margin-top: 1.3rem; color: #454950; }
  .compare-label { display: none; }
  .comparison { min-width: 650px; font-size: .97rem; }
  .comparison th, .comparison td { text-align: left; padding: 1.3rem 1.2rem; border-bottom: 1px solid var(--color-neutral-200); vertical-align: top; }
  .comparison thead th { font-family: var(--font-display); font-size: .95rem; }
  .comparison th:first-child { width: 22%; padding-left: 0; }
  .comparison tbody th { font-weight: 600; }
  .comparison td { width: 39%; color: #454950; }
  .comparison tr > :last-child { background: var(--color-surface); }
  .comparison thead th:last-child { border-bottom: 3px solid var(--color-yellow); color: var(--color-ink); }
  .limits-note { max-width: 90ch; font-size: .87rem; color: #52565e; margin-top: 1.5rem; }
  .operations-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; align-items: center; }
  .features { margin-block: 1.5rem; }
  .features > div { padding-block: 1.1rem; border-bottom: 1px solid var(--color-neutral-200); }
  dt { font-family: var(--font-display); font-weight: 600; font-size: 1rem; }
  dd { margin: .5rem 0 0; font-size: .98rem; color: #454950; }
  .text-link { display: inline-block; padding-block: .6rem; font-weight: 600; }
  figure { margin: 0; }
  .product img { height: auto; width: 100%; border-radius: var(--radius-lg); box-shadow: var(--shadow-lifted); }
  figcaption { margin-top: 1.2rem; text-align: center; font-size: .82rem; color: #52565e; }
  .workflow { display: grid; grid-template-columns: repeat(3, 1fr); list-style: none; padding: 0; margin: 0; gap: 2rem; }
  .workflow li { border-top: 1px solid var(--color-neutral-200); padding-top: 1.5rem; }
  .step { display: grid; place-items: center; width: 2rem; height: 2rem; background: var(--color-yellow); border-radius: 50%; font-size: .9rem; font-weight: 600; margin-bottom: 1rem; }
  .workflow p { margin-top: .8rem; color: #454950; font-size: 1rem; }
  .faq-grid { display: grid; grid-template-columns: 1fr 1.6fr; gap: 4rem; }
  details { border-bottom: 1px solid var(--color-neutral-200); }
  summary { cursor: pointer; font-weight: 600; padding-block: 1.2rem; min-height: 48px; }
  details p { padding-bottom: 1.3rem; color: #454950; font-size: 1rem; }
  .closing { background: var(--color-ink); color: var(--color-surface); text-align: center; padding-block: 5rem; }
  .closing h2 { max-width: 25ch; margin-inline: auto; }
  .closing p { max-width: 63ch; margin: 1.3rem auto 0; color: #ddd; }
  .dark-secondary { border-color: #686868; color: var(--color-surface); background: transparent; }
  .closing :focus-visible { outline-color: var(--color-yellow); }
  .dark-secondary:hover { border-color: var(--color-surface); }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; border: 0; }
  @media (max-width: 800px) {
    .operations-grid, .faq-grid { grid-template-columns: 1fr; gap: 2.5rem; }
    .product { max-width: 38rem; margin-inline: auto; }
    .workflow { gap: 1.3rem; }
  }
  @media (max-width: 540px) {
    .container { padding-inline: 1.25rem; }
    .hero { padding-block: 2.5rem; }
    h1 { font-size: clamp(2rem, 8.5vw, 2.8rem); }
    .hero > p { font-size: 1.05rem; }
    .buttons { flex-direction: column; align-items: stretch; }
    .section { padding-block: 3.5rem; }
    .report { padding-bottom: 3.5rem; }
    .report-heading { gap: .75rem; }
    .workbook-bar { padding: .9rem; font-size: .75rem; }
    .filetype { display: none; }
    .sheet-links { flex-wrap: nowrap; overflow-x: auto; padding-inline: .5rem; scrollbar-width: thin; }
    .sheet-links button { flex: 1; text-align: center; padding-inline: .5rem; font-size: .77rem; }
    .sheet-panel { padding: 1rem .75rem 0; }
    .table-hint { padding-inline: .75rem; }
    .workflow { grid-template-columns: 1fr; gap: 1.6rem; }
    .workflow li { display: grid; grid-template-columns: 2rem 1fr; column-gap: 1rem; align-items: center; }
    .step { grid-row: 1 / 3; align-self: start; margin-bottom: 0; }
    .workflow p { grid-column: 2; margin-top: .5rem; }
    .comparison, .comparison tbody { display: block; min-width: 0; font-size: .95rem; }
    .comparison thead { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
    .comparison tbody tr { display: grid; grid-template-columns: 1fr 1fr; border-bottom: 1px solid var(--color-neutral-200); padding-block: 1.3rem; }
    .comparison th, .comparison td { border: 0; padding: .8rem; }
    .comparison tbody th:first-child { grid-column: 1 / -1; width: auto; padding: 0 0 .8rem; font-size: 1rem; }
    .comparison td { width: auto; }
    .comparison td:nth-child(2) { padding-left: 0; }
    .compare-label { display: block; font-size: .8rem; font-weight: 600; margin-bottom: .6rem; color: var(--color-ink); }
    .closing { padding-block: 3.5rem; }
  }
</style>

<script>
  const workbook = document.querySelector<HTMLElement>('.workbook');
  const links = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-sheet-tab]'));
  const panels = Array.from(document.querySelectorAll<HTMLElement>('.sheet-panel'));
  if (workbook && links.length === panels.length && links.length > 0) {
    const list = workbook.querySelector('.sheet-links');
    list?.setAttribute('role', 'tablist');
    const activate = (index: number, focus = false) => {
      links.forEach((link, i) => {
        link.setAttribute('aria-selected', String(i === index));
        link.tabIndex = i === index ? 0 : -1;
        panels[i].hidden = i !== index;
      });
      if (focus) links[index].focus({ preventScroll: true });
    };
    links.forEach((link, index) => {
      link.setAttribute('role', 'tab');
      link.setAttribute('aria-controls', panels[index].id);
      panels[index].setAttribute('role', 'tabpanel');
      panels[index].setAttribute('aria-labelledby', link.id);
      link.addEventListener('click', (event) => { event.preventDefault(); activate(index); });
      link.addEventListener('keydown', (event) => {
        let next = index;
        if (event.key === 'ArrowRight') next = (index + 1) % links.length;
        else if (event.key === 'ArrowLeft') next = (index - 1 + links.length) % links.length;
        else if (event.key === 'Home') next = 0;
        else if (event.key === 'End') next = links.length - 1;
        else if (event.key === ' ') { event.preventDefault(); activate(index); return; }
        else return;
        event.preventDefault(); activate(next, true);
      });
    });
    const followHash = () => {
      const index = panels.findIndex((panel) => `#${panel.id}` === location.hash);
      activate(index >= 0 ? index : 0);
    };
    workbook.dataset.enhanced = 'true';
    followHash();
    window.addEventListener('hashchange', followHash);
  }
</script>
