---
import '@fontsource/inter/600.css';
import '@fontsource/inter/700.css';
import '@fontsource/work-sans/400.css';
import '@fontsource/work-sans/500.css';
import '@fontsource/work-sans/600.css';
import '../styles/global.css';
import Header from './Header.astro';
import Footer from './Footer.astro';
import ContactModal from './ContactModal.astro';
import Analytics from './Analytics.astro';
import { getMyClientiContent } from '../i18n/myclienti';
import type { Lang } from '../i18n/ui';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = getMyClientiContent(lang);
const home = lang === 'en' ? '/en/' : '/';
const path = `${home}myclienti/`;
const site = 'https://mysagra.com';
const canonical = `${site}${path}`;
const demo = 'https://clientidemo.mysagra.com/';
const ids = ['customize', 'sync', 'share'];
const orderScreens = [
  { name: 'myclienti-order-menu', height: 1282 },
  { name: 'myclienti-order-cart', height: 1599 },
  { name: 'myclienti-order-confirmation', height: 2536 },
];
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'Organization', '@id': `${site}/#organization`, name: 'MySagra', url: `${site}/`, logo: `${site}/favicon.svg`, sameAs: ['https://github.com/mysagra'] },
    { '@type': 'WebPage', '@id': `${canonical}#webpage`, url: canonical, name: t.title, description: t.description, inLanguage: lang, publisher: { '@id': `${site}/#organization` }, mainEntity: { '@id': `${canonical}#software` }, breadcrumb: { '@id': `${canonical}#breadcrumb` } },
    { '@type': 'SoftwareApplication', '@id': `${canonical}#software`, name: 'MyClienti', applicationCategory: 'BusinessApplication', operatingSystem: 'Web', url: canonical, description: t.intro, inLanguage: lang, featureList: t.fields.map(([title, description]) => `${title}: ${description}`), screenshot: [`${site}/images/myclienti-app-1.webp`, ...orderScreens.map((screen) => `${site}/images/${screen.name}.webp`)], publisher: { '@id': `${site}/#organization` } },
    { '@type': 'BreadcrumbList', '@id': `${canonical}#breadcrumb`, itemListElement: [{ '@type': 'ListItem', position: 1, name: 'MySagra', item: `${site}${home}` }, { '@type': 'ListItem', position: 2, name: 'MyClienti', item: canonical }] },
    { '@type': 'FAQPage', '@id': `${canonical}#faq`, isPartOf: { '@id': `${canonical}#webpage` }, inLanguage: lang, mainEntity: t.faq.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) },
  ],
};
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.title}</title>
    <meta name="description" content={t.description} />
    <meta name="theme-color" content="#FECC01" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="it" href={`${site}/myclienti/`} />
    <link rel="alternate" hreflang="en" href={`${site}/en/myclienti/`} />
    <link rel="alternate" hreflang="x-default" href={`${site}/myclienti/`} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="MySagra" />
    <meta property="og:title" content={t.title} />
    <meta property="og:description" content={t.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'it_IT'} />
    <meta property="og:locale:alternate" content={lang === 'en' ? 'it_IT' : 'en_US'} />
    <meta property="og:image" content={`${site}/images/myclienti-app-1.webp`} />
    <meta property="og:image:alt" content={t.alt} />
    <meta property="og:image:width" content="1170" />
    <meta property="og:image:height" content="2532" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={t.title} />
    <meta name="twitter:description" content={t.description} />
    <meta name="twitter:image" content={`${site}/images/myclienti-app-1.webp`} />
    <meta name="twitter:image:alt" content={t.alt} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />
    <Analytics lang={lang} />
  </head>
  <body>
    <a href="#main" class="skip-link">{lang === 'en' ? 'Skip to content' : 'Vai al contenuto'}</a>
    <Header lang={lang} />
    <main id="main">
      <div class="container">
        <nav class="breadcrumb" aria-label="Breadcrumb"><a href={home}>MySagra</a><span aria-hidden="true">/</span><span aria-current="page">MyClienti</span></nav>
        <section class="hero" aria-labelledby="hero-title">
          <div class="hero-copy">
            <h1 id="hero-title">{t.headline}{' '}<span>{t.headlineEnd}</span></h1>
            <p class="lede">{t.intro}</p>
            <div class="buttons">
              <a class="btn primary" href={demo} data-umami-event="myclienti-demo-click" data-umami-event-location="hero">{t.demo}</a>
              <button class="btn secondary" type="button" data-open-contact="informazioni" data-request-type="demo" data-umami-event="contact-open" data-umami-event-location="myclienti-hero">{t.access}</button>
            </div>
            <p class="small-note">{t.note} <a href={`${home}#solutions`} data-umami-event="myclienti-plans-click" data-umami-event-location="hero">{t.plans}</a></p>
          </div>
          <figure class="hero-product">
            <img src="/images/myclienti-app-1-540.webp" srcset="/images/myclienti-app-1-540.webp 540w, /images/myclienti-app-1.webp 1170w" sizes="(max-width: 363px) 200px, (max-width: 445px) 55vw, (max-width: 740px) 245px, 270px" alt={t.alt} width="1170" height="2532" fetchpriority="high" />
            <figcaption>{t.caption}</figcaption>
          </figure>
        </section>
        <ol class="journey" aria-label={lang === 'en' ? 'From your idea to your online menu' : 'Dalla tua idea al menu online'}>
          {t.journey.map(([title, desc], index) => <li><a href={`#${ids[index]}`}><span class="step" aria-hidden="true">{index + 1}</span><span><strong>{title}</strong><span class="journey-desc">{desc}</span></span></a></li>)}
        </ol>
      </div>
      <section id="customize" class="section warm">
        <div class="container customize-grid">
          <div>
            <h2>{t.customizeTitle}</h2>
            <p class="section-intro">{t.customizeIntro}</p>
            <dl class="fields">{t.fields.map(([title, desc]) => <div><dt>{title}</dt><dd>{desc}</dd></div>)}</dl>
            <button class="text-action" type="button" data-open-contact="informazioni" data-request-type="demo">{t.access}</button>
          </div>
          <div class="preview">
            <div class="preview-controls" hidden aria-label={t.previewTitle}>
              {t.previewButtons.map((label, index) => <button type="button" data-preview={index} aria-pressed={index === 2}>{label}</button>)}
            </div>
            <figure>
              <div class="preview-stage">
                <div class="preview-frame">
                  <img id="menu-preview" src="/images/mysagra-admin-categories-540.webp" srcset="/images/mysagra-admin-categories-540.webp 540w, /images/mysagra-admin-categories.webp 1080w" sizes="(max-width: 440px) calc(100vw - 40px), 400px" alt={t.adminAlt} data-banner-alt={t.bannerAlt} data-categories-alt={t.categoriesAlt} data-admin-alt={t.adminAlt} width="1080" height="1145" loading="lazy" decoding="async" />
                </div>
              </div>
              <figcaption>{t.previewNote}</figcaption>
            </figure>
          </div>
        </div>
      </section>
      <section id="sync" class="section" aria-labelledby="sync-title">
        <div class="container">
          <div class="sync-grid">
            <div class="sync-copy">
              <h2 id="sync-title">{t.syncTitle}</h2>
              <p class="section-intro"><strong>{t.syncLive}</strong> {t.syncIntro}</p>
              <a class="text-action" href={`${home}#ecosystem`}>{t.ecosystem}<svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 12h16m-6-6 6 6-6 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg></a>
            </div>
            <figure class="ecosystem-flow" aria-label={t.syncDiagram}>
              <div class="sync-hub">
                <svg class="sync-icon" width="28" height="28" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="3" y="3" width="18" height="7" rx="2" stroke="currentColor" stroke-width="1.5" /><rect x="3" y="14" width="18" height="7" rx="2" stroke="currentColor" stroke-width="1.5" /><path d="M7 6.5h.01M7 17.5h.01M12 6.5h5M12 17.5h5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></svg>
                <h3>MySagra</h3><p>{t.syncRoles[0]}</p>
              </div>
              <div class="sync-connectors" aria-hidden="true"><span></span></div>
              <div class="sync-endpoints">
                <div class="sync-node">
                  <svg class="sync-icon" width="28" height="28" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="6" y="2" width="12" height="20" rx="3" stroke="currentColor" stroke-width="1.5" /><path d="M10 5h4M11 19h2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></svg>
                  <h3>MyClienti</h3><p>{t.syncRoles[1]}</p>
                </div>
                <div class="sync-node">
                  <svg class="sync-icon" width="28" height="28" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="3" y="3" width="18" height="12" rx="2" stroke="currentColor" stroke-width="1.5" /><path d="M9 15v4m6-4v4M6 20h12M7 7h10M7 11h5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></svg>
                  <h3>MyCassa</h3><p>{t.syncRoles[2]}</p>
                </div>
              </div>
            </figure>
          </div>
          <div class="order-recovery">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="10.5" cy="10.5" r="7" stroke="currentColor" stroke-width="1.5" /><path d="m16 16 5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /><circle cx="10.5" cy="8.5" r="2" stroke="currentColor" stroke-width="1.5" /><path d="M7 14c.5-2 6.5-2 7 0" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></svg>
            <div><h3>{t.recoveryTitle}</h3><p>{t.recoveryCopy}</p></div>
          </div>
        </div>
      </section>
      <section id="share" class="section warm">
        <div class="container share-grid">
          <div><h2>{t.shareTitle}</h2><p class="section-intro">{t.shareIntro}</p><a class="btn primary" href={demo} data-umami-event="myclienti-demo-click" data-umami-event-location="share">{t.demo}</a></div>
          <dl class="share-details">{t.shareDetails.map(([title, desc]) => <div><dt>{title}</dt><dd>{desc}</dd></div>)}</dl>
        </div>
      </section>
      <section id="ordering" class="section" aria-labelledby="ordering-title">
        <div class="container">
          <div class="section-heading"><h2 id="ordering-title">{t.orderTitle}</h2><p class="section-intro">{t.orderIntro}</p></div>
          <ol class="order-steps">
            {orderScreens.map((screen, index) => <li>
              <div class="order-step-heading"><span class="step" aria-hidden="true">{index + 1}</span><h3>{t.orderSteps[index][0]}</h3></div>
              <p>{t.orderSteps[index][1]}</p>
              <img src={`/images/${screen.name}-540.webp`} srcset={`/images/${screen.name}-540.webp 540w, /images/${screen.name}.webp 1080w`} sizes="(max-width: 740px) 270px, (max-width: 850px) 200px, 270px" alt={t.orderSteps[index][2]} width="1080" height={screen.height} loading="lazy" decoding="async" />
            </li>)}
          </ol>
          <p class="order-note">{t.orderNote}</p>
        </div>
      </section>
      <section id="access" class="section warm">
        <div class="container">
          <div class="section-heading"><h2>{t.demoTitle}</h2><p class="section-intro">{t.demoIntro}</p></div>
          <div class="access-grid">
            <article><h3>{t.publicTitle}</h3><p>{t.publicCopy}</p><a class="btn primary" href={demo} data-umami-event="myclienti-demo-click" data-umami-event-location="access">{t.demo}</a></article>
            <article><h3>{t.adminTitle}</h3><p>{t.adminCopy}</p><button class="btn secondary" type="button" data-open-contact="informazioni" data-request-type="demo" data-umami-event="contact-open" data-umami-event-location="myclienti-access">{t.access}</button></article>
          </div>
          <div class="plans-callout">
            <div><h3>{t.plansTitle}</h3><p>{t.plansCopy}</p></div>
            <a class="btn primary" href={`${home}#solutions`} data-umami-event="myclienti-plans-click" data-umami-event-location="access">{t.plans}</a>
          </div>
        </div>
      </section>
      <section class="section warm faq" aria-labelledby="faq-title">
        <div class="container faq-grid"><h2 id="faq-title">{t.faqTitle}</h2><div>{t.faq.map(([q, a]) => <details><summary>{q}</summary><p>{a}</p></details>)}</div></div>
      </section>
      <section class="closing">
        <div class="container"><h2>{t.closing}</h2><p>{t.closingCopy}</p><div class="buttons"><a class="btn primary" href={`${home}#solutions`} data-umami-event="myclienti-plans-click" data-umami-event-location="closing">{t.plans}</a><button class="btn dark-secondary" type="button" data-open-contact="informazioni" data-request-type="demo">{t.access}</button></div></div>
      </section>
    </main>
    <Footer lang={lang} />
    <ContactModal lang={lang} defaultSubject={t.subject} />
  </body>
</html>

<style>
  :global(body) { background: var(--color-surface); }
  .container { max-width: 71rem; padding-inline: 1.5rem; margin-inline: auto; }
  a { text-underline-offset: .22em; }
  .skip-link { position: fixed; top: -6rem; left: 1rem; z-index: 100; padding: .75rem; background: var(--color-yellow); }
  .skip-link:focus { top: 1rem; }
  .breadcrumb { display: flex; gap: .75rem; font-size: .85rem; padding-top: 1.8rem; color: #52565e; }
  .hero { display: grid; grid-template-columns: 1.3fr 1fr; gap: 4rem; align-items: center; padding: 2.2rem 0 3.5rem; }
  h1 { font-size: clamp(2.3rem, 4.1vw, 3.6rem); line-height: 1.1; max-width: 16ch; }
  h1 span { display: block; margin-top: .22em; }
  .lede { margin-top: 1.6rem; font-size: 1.14rem; max-width: 49ch; color: #454950; }
  .buttons { display: flex; flex-wrap: wrap; gap: .8rem; margin-top: 1.8rem; }
  .btn { display: inline-flex; align-items: center; justify-content: center; gap: .8rem; padding: .9rem 1.45rem; min-height: 48px; border-radius: var(--radius-pill); border: 1px solid transparent; font-size: .95rem; font-weight: 600; text-decoration: none; cursor: pointer; transition: transform .2s, box-shadow .2s, border-color .2s; }
  .primary { background: var(--color-yellow); color: var(--color-ink); }
  .secondary { background: var(--color-surface); border-color: var(--color-neutral-200); }
  .btn:hover { transform: translateY(-1px); box-shadow: var(--shadow-soft); }
  .secondary:hover { border-color: var(--color-ink); }
  .small-note a { display: inline-block; font-weight: 600; padding-block: .5rem; }
  .small-note { margin-top: 1.2rem; font-size: .86rem; color: #52565e; max-width: 48ch; }
  figure { margin: 0; }
  .hero-product { justify-self: center; text-align: center; }
  .hero-product img { width: 270px; height: auto; border: 1px solid var(--color-neutral-200); border-radius: var(--radius-lg); box-shadow: var(--shadow-lifted); }
  figcaption { margin: 1.1rem auto 0; max-width: 37ch; font-size: .78rem; color: #52565e; }
  .journey { display: grid; grid-template-columns: repeat(3, 1fr); list-style: none; padding: 0; margin: 0 0 4rem; border-block: 1px solid var(--color-neutral-200); }
  .journey li + li { border-left: 1px solid var(--color-neutral-200); }
  .journey a { display: flex; align-items: center; gap: .9rem; padding: 1.5rem 1.1rem; text-decoration: none; height: 100%; }
  .journey a:hover { background: var(--color-surface-warm); }
  .step { display: grid; place-items: center; width: 2rem; height: 2rem; flex-shrink: 0; background: var(--color-yellow); border-radius: 50%; font-weight: 600; font-size: .9rem; }
  .journey strong { display: block; font-family: var(--font-display); font-size: 1rem; }
  .journey-desc { display: block; font-size: .84rem; color: #52565e; margin-top: .25rem; }
  .section { padding-block: 6rem; scroll-margin-top: 6rem; }
  .warm { background: var(--color-surface-warm); }
  h2 { font-size: clamp(1.8rem, 3.1vw, 2.6rem); line-height: 1.13; }
  h3 { font-size: 1.3rem; }
  .section-intro { margin-top: 1.3rem; max-width: 68ch; color: #454950; }
  .customize-grid { display: grid; grid-template-columns: 1.15fr 1fr; align-items: center; gap: 6rem; }
  dl { margin: 0; }
  dt { font-family: var(--font-display); font-weight: 600; }
  dd { margin: .45rem 0 0; color: #454950; font-size: 1rem; }
  .fields { margin-block: 2rem; }
  .fields > div { padding-block: 1.1rem; border-bottom: 1px solid var(--color-neutral-200); }
  .text-action { display: inline-flex; gap: .5rem; color: var(--color-ink); border: 0; background: none; padding: .65rem 0; font-weight: 600; text-decoration: underline; cursor: pointer; font-size: 1rem; text-underline-offset: .25em; }
  .text-action:hover { text-decoration-thickness: 2px; }
  .preview { text-align: center; overflow: clip; padding-block: 1.5rem; margin-block: -1.5rem; }
  .preview-controls { display: flex; justify-content: center; background: var(--color-neutral-200); border-radius: var(--radius-sm); padding: .3rem; gap: .25rem; margin: 0 auto 1.5rem; width: fit-content; }
  .preview-controls[hidden] { display: none; }
  .preview-controls button { border: 0; background: transparent; border-radius: var(--radius-sm); padding: .75rem .85rem; font-size: .85rem; cursor: pointer; }
  .preview-controls button[aria-pressed="true"] { background: var(--color-surface); box-shadow: var(--shadow-soft); }
  .preview-stage { position: relative; width: min(100%, 400px); aspect-ratio: 1080 / 1145; margin-inline: auto; }
  .preview-frame { width: 100%; height: 100%; overflow: hidden; border-radius: var(--radius-lg); box-shadow: var(--shadow-lifted); background: var(--color-surface); }
  .preview-frame img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .preview-stage :global(.preview-outgoing) { position: absolute; inset: 0; pointer-events: none; }
  .order-steps { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 2rem; padding: 0; margin: 3rem 0 0; list-style: none; }
  .order-step-heading { display: flex; align-items: center; gap: .75rem; }
  .order-step-heading h3 { font-size: 1.1rem; line-height: 1.3; }
  .order-steps p { color: #454950; margin-top: .8rem; min-height: 4.7rem; }
  .order-steps img { width: 270px; height: auto; margin: 1.5rem auto 0; border-radius: var(--radius-lg); box-shadow: var(--shadow-soft); }
  .order-note { font-size: .875rem; color: #52565e; text-align: center; margin: 2rem auto 0; max-width: 75ch; }
  .section-heading { max-width: 49rem; margin-inline: auto; text-align: center; }
  .sync-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; align-items: center; }
  .sync-copy h2 { max-width: 20ch; }
  .sync-copy .text-action { margin-top: 1.3rem; gap: .75rem; }
  .ecosystem-flow { padding: 2rem; background: var(--color-surface-warm); border-radius: var(--radius-lg); }
  .sync-hub { padding: 1.5rem; background: var(--color-ink); color: var(--color-surface); border-radius: var(--radius); text-align: center; }
  .sync-copy strong { color: var(--color-ink); }
  .sync-hub .sync-icon { color: var(--color-ink); background: var(--color-yellow); }
  .sync-hub h3 { font-size: 1.6rem; color: var(--color-yellow); }
  .sync-hub p { margin-top: .4rem; font-size: .95rem; }
  .sync-connectors { position: relative; height: 3rem; width: 50%; margin-inline: auto; }
  .sync-connectors::before { content: ''; position: absolute; top: 0; left: 50%; height: 50%; border-left: 1px solid var(--color-ink); }
  .sync-connectors span { position: absolute; inset: 50% 0 0; border: 1px solid var(--color-ink); border-bottom: 0; border-radius: .5rem .5rem 0 0; }
  .sync-endpoints { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  .sync-node { padding: 1.25rem 1rem; border: 1px solid var(--color-neutral-200); background: var(--color-surface); border-radius: var(--radius); text-align: center; }
  .sync-icon { display: block; box-sizing: content-box; padding: .6rem; margin: 0 auto .8rem; border-radius: var(--radius-sm); background: color-mix(in srgb, var(--color-yellow) 16%, transparent); }
  .sync-node h3 { font-size: 1.2rem; }
  .sync-node p { font-size: .95rem; margin-top: .5rem; }
  .order-recovery { display: flex; align-items: flex-start; gap: 1.25rem; padding: 2rem; margin-top: 3rem; background: var(--color-surface-warm); border-radius: var(--radius-lg); }
  .order-recovery > svg { flex-shrink: 0; box-sizing: content-box; padding: .75rem; background: var(--color-yellow); border-radius: var(--radius-sm); }
  .order-recovery h3 { font-size: 1.25rem; line-height: 1.3; }
  .order-recovery p { margin-top: .65rem; color: #454950; max-width: 80ch; }
  .share-grid { display: grid; grid-template-columns: 1.1fr 1fr; gap: 6rem; }
  .share-grid .btn { margin-top: 1.7rem; }
  .share-details > div { padding-block: 1.3rem; border-bottom: 1px solid var(--color-neutral-200); }
  .share-details > div:first-child { padding-top: 0; }
  .access-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin-top: 3rem; }
  .access-grid article { display: flex; flex-direction: column; align-items: flex-start; padding: 2.25rem; border: 1px solid var(--color-neutral-200); border-radius: var(--radius-lg); }
  .access-grid p { margin-block: 1rem 1.5rem; color: #454950; }
  .access-grid .btn { margin-top: auto; }
  .plans-callout { display: flex; align-items: center; justify-content: space-between; gap: 2rem; margin-top: 2.5rem; padding-top: 2.5rem; border-top: 1px solid var(--color-neutral-200); }
  .plans-callout p { max-width: 62ch; margin-top: .8rem; color: #454950; }
  .plans-callout .btn { flex-shrink: 0; }
  .faq-grid { display: grid; grid-template-columns: 1fr 1.6fr; gap: 5rem; }
  details { border-bottom: 1px solid var(--color-neutral-200); padding-block: 1.1rem; }
  details:first-child { padding-top: 0; }
  summary { cursor: pointer; font-weight: 600; padding-block: .5rem; }
  details p { padding: .7rem 0 .4rem; color: #454950; font-size: 1rem; }
