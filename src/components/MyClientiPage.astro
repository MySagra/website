<script>
  const preview = document.querySelector<HTMLImageElement>('#menu-preview');
  const controls = document.querySelector<HTMLElement>('.preview-controls');
  const frame = document.querySelector<HTMLElement>('.preview-frame');
  const stage = document.querySelector<HTMLElement>('.preview-stage');
  if (preview && controls && frame && stage) {
    controls.hidden = false;
    const buttons = [...controls.querySelectorAll<HTMLButtonElement>('button')];
    const names = ['myclienti-preview-banner', 'myclienti-preview-categories', 'mysagra-admin-categories'];
    const alts = [preview.dataset.bannerAlt, preview.dataset.categoriesAlt, preview.dataset.adminAlt];
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let currentIndex = 2;
    let requestId = 0;
    let animations: Animation[] = [];

    const selectPreview = async (index: number) => {
      const id = ++requestId;
      animations.forEach((animation) => animation.cancel());
      stage.querySelector('.preview-outgoing')?.remove();
      if (index === currentIndex) return;

      const next = new Image();
      next.sizes = preview.sizes;
      next.srcset = `/images/${names[index]}-540.webp 540w, /images/${names[index]}.webp 1080w`;
      next.src = `/images/${names[index]}-540.webp`;
      try {
        await next.decode();
      } catch {
        return;
      }
      if (id !== requestId) return;

      const outgoing = frame.cloneNode(true) as HTMLElement;
      outgoing.classList.add('preview-outgoing');
      outgoing.querySelector('img')?.removeAttribute('id');
      outgoing.setAttribute('aria-hidden', 'true');
      const direction = index > currentIndex ? 1 : -1;
      preview.srcset = next.srcset;
      preview.src = next.src;
      preview.alt = alts[index] || '';
      currentIndex = index;
      buttons.forEach((button, i) => button.setAttribute('aria-pressed', String(i === index)));
      if (reducedMotion.matches) return;

      stage.append(outgoing);
      const timing = { duration: 360, easing: 'cubic-bezier(.16, 1, .3, 1)' };
      animations = [
        outgoing.animate([
          { transform: 'translateX(0) rotate(0)', opacity: 1 },
          { transform: `translateX(${-direction * 64}px) rotate(${-direction * 3}deg)`, opacity: 0 },
        ], { ...timing, fill: 'forwards' }),
        frame.animate([
          { transform: `translateX(${direction * 64}px) rotate(${direction * 3}deg)`, opacity: 0 },
          { transform: 'translateX(0) rotate(0)', opacity: 1 },
        ], timing),
      ];
      await Promise.allSettled(animations.map((animation) => animation.finished));
      outgoing.remove();
    };
    buttons.forEach((button, index) => button.addEventListener('click', () => { void selectPreview(index); }));
  }
</script>
