---
import { getContactContent } from '../i18n/contact';
import { contactLabels, contactSource } from '../lib/contact';
import type { Lang } from '../i18n/ui';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = getContactContent(lang);
const home = lang === 'en' ? '/en/' : '/';
---
<form id="contact-form" class="contact-form rr-block" novalidate data-config={JSON.stringify({ ...t, labels: contactLabels[lang], source: contactSource(Astro.url.pathname) })}>
  <input type="hidden" name="lang" value={lang} />
  <input type="hidden" name="sourcePath" value={Astro.url.pathname} />
  <input type="hidden" name="plan" value="" />
  <input type="hidden" name="contextPeriod" value="" />
  <p class="required-note">{t.required}</p>
  <div class="context" hidden><p><span>{t.context}</span> <strong data-context-label></strong></p><button type="button" data-clear-context>{t.change}</button></div>
  <fieldset class="intent-fieldset">
    <legend>{t.intent}</legend>
    <div class="choices">
      {(['demo', 'preventivo', 'informazioni'] as const).map((value, i) => <label><input type="radio" name="requestType" value={value} checked={value === 'informazioni'} /><span>{[t.demo, t.quote, t.question][i]}</span></label>)}
    </div>
  </fieldset>
  <div class="identity">
    <label class="field"><span>{t.name}</span><input type="text" name="name" autocomplete="name" required maxlength="120" /></label>
    <label class="field"><span>{t.email}</span><input type="email" name="email" autocomplete="email" required maxlength="254" inputmode="email" /></label>
  </div>
  <label class="field"><span>{t.phone}</span><input type="tel" name="phone" autocomplete="tel" maxlength="60" /></label>
  <fieldset class="period-fieldset" hidden>
    <legend>{t.period}</legend>
    <div class="period-choices">{(['', 'weekly', 'monthly'] as const).map((value, i) => <label><input type="radio" name="period" value={value} checked={value === ''} /><span>{[t.undecided, t.weekly, t.monthly][i]}</span></label>)}</div>
    <p class="hint">{t.periodNote}</p>
  </fieldset>
  <label class="field"><span>{t.message}</span><span class="hint" id="message-hint">{t.messageHint}</span><textarea name="message" rows="3" required maxlength="6000" placeholder={t.messagePlaceholder} aria-describedby="message-hint"></textarea></label>
  <p class="privacy">{t.privacy} <a href={`${home}privacy-policy/`}>{t.privacyLink}</a>.</p>
  <p id="contact-status" class="form-status" role="status" aria-live="polite" tabindex="-1"></p>
  <button type="submit" class="submit" id="contact-submit" disabled>{t.submit}</button>
  <button type="button" class="submit another" hidden>{t.another}</button>
  <noscript><p class="fallback">{t.nojs} <a href="mailto:info@mysagra.com">info@mysagra.com</a>.</p></noscript>
</form>

<style>
  .contact-form { color: var(--color-ink); }
  .required-note, .privacy, .hint { font-size: .82rem; color: #52565e; }
  .required-note { margin-bottom: 1.2rem; }
  fieldset { border: 0; margin: 0 0 1.2rem; padding: 0; min-width: 0; }
  legend, .field > span:first-child { font-size: .9rem; font-weight: 600; margin-bottom: .45rem; padding: 0; }
  .choices { display: grid; grid-template-columns: repeat(3, 1fr); gap: .5rem; }
  .choices label { position: relative; display: flex; }
  .choices input { position: absolute; width: 1px; height: 1px; opacity: 0; }
  .choices span { display: grid; place-items: center; width: 100%; padding: .7rem .45rem; min-height: 48px; border: 1px solid var(--color-neutral-200); border-radius: var(--radius); font-size: .85rem; font-weight: 500; text-align: center; cursor: pointer; }
  .choices input:checked + span { background: #fff7d6; border-color: var(--color-ink); box-shadow: inset 0 0 0 1px var(--color-ink); }
  .choices input:focus-visible + span { outline: 3px solid var(--color-ink); outline-offset: 3px; }
  .choices span:hover { border-color: var(--color-ink); }
  .identity { display: grid; grid-template-columns: 1fr 1fr; gap: .8rem; }
  .field { display: block; margin-bottom: 1rem; }
  .field > span { display: block; }
  .field .hint { font-weight: 400; margin-bottom: .5rem; }
  .field input, .field textarea { width: 100%; min-height: 48px; padding: .7rem .85rem; border: 1px solid var(--color-neutral-200); border-radius: var(--radius); font: inherit; font-size: 1rem; color: var(--color-ink); background: var(--color-surface); caret-color: var(--color-ink); }
  .field textarea { min-height: 100px; resize: vertical; max-height: 240px; }
  .field textarea::placeholder { color: #646871; opacity: 1; }
  .field input[aria-invalid='true'], .field textarea[aria-invalid='true'] { border-color: var(--color-danger); }
  .period-choices { display: flex; flex-wrap: wrap; gap: .5rem 1rem; margin-bottom: .5rem; }
  .period-choices label { display: flex; gap: .4rem; align-items: center; min-height: 44px; font-size: .9rem; cursor: pointer; }
  .period-choices input { accent-color: var(--color-ink); width: 18px; height: 18px; }
  .context { display: flex; align-items: center; justify-content: space-between; gap: .75rem; padding: .9rem; margin-bottom: 1rem; background: var(--color-surface-warm); border-radius: var(--radius); font-size: .85rem; }
  .context strong { display: block; }
  .context button { background: none; border: 0; min-height: 44px; padding: .4rem; text-decoration: underline; cursor: pointer; }
  .privacy { margin-block: .2rem 1rem; }
  a { text-underline-offset: .2em; }
  .form-status { font-size: .92rem; }
  .form-status:not(:empty) { padding: .85rem; margin-bottom: 1rem; border-radius: var(--radius); background: var(--color-surface-warm); }
  .form-status[data-state='error'] { color: #a51c1c; }
  .form-status[data-state='success'] { color: #12642d; }
  .submit { width: 100%; min-height: 48px; padding: .8rem; border: 0; border-radius: var(--radius-pill); background: var(--color-yellow); color: var(--color-ink); font: inherit; font-weight: 600; cursor: pointer; transition: box-shadow .2s; }
  .submit:hover { box-shadow: var(--shadow-soft); }
  .submit:disabled { opacity: .65; cursor: wait; }
  .fallback { margin-top: 1rem; }
  [hidden] { display: none !important; }
  @media (max-width: 460px) { .identity { grid-template-columns: 1fr; gap: 0; } .choices span { font-size: .8rem; } }
</style>
<script src="../scripts/contact-form.ts"></script>
