---
import '@fontsource/inter/600.css';
import '@fontsource/inter/700.css';
import '@fontsource/work-sans/400.css';
import '@fontsource/work-sans/500.css';
import '@fontsource/work-sans/600.css';
import '../styles/global.css';
import Header from './Header.astro';
import Footer from './Footer.astro';
import ContactForm from './ContactForm.astro';
import Analytics from './Analytics.astro';
import { getContactContent } from '../i18n/contact';
import type { Lang } from '../i18n/ui';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = getContactContent(lang);
const home = lang === 'en' ? '/en/' : '/';
const site = 'https://mysagra.com';
const canonical = `${site}${home}contact/`;
const schema = { '@context': 'https://schema.org', '@type': 'ContactPage', name: t.pageTitle, description: t.description, url: canonical, inLanguage: lang, mainEntity: { '@type': 'Organization', name: 'MySagra', url: site, email: 'info@mysagra.com' } };
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.pageTitle}</title>
    <meta name="description" content={t.description} />
    <meta name="theme-color" content="#FECC01" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="it" href={`${site}/contact/`} />
    <link rel="alternate" hreflang="en" href={`${site}/en/contact/`} />
    <link rel="alternate" hreflang="x-default" href={`${site}/contact/`} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="MySagra" />
    <meta property="og:title" content={t.pageTitle} />
    <meta property="og:description" content={t.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'it' ? 'it_IT' : 'en_US'} />
    <meta property="og:image" content={`${site}/images/mycassa-terminal.webp`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={t.pageTitle} />
    <meta name="twitter:description" content={t.description} />
    <meta name="twitter:image" content={`${site}/images/mycassa-terminal.webp`} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />
    <Analytics lang={lang} />
  </head>
  <body>
    <a class="skip-link" href="#main">{lang === 'it' ? 'Vai al contenuto' : 'Skip to content'}</a>
    <Header lang={lang} />
    <main id="main" class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb"><a href={home}>MySagra</a><span aria-hidden="true">/</span><span aria-current="page">{t.contact}</span></nav>
      <div class="contact-layout">
        <div class="copy">
          <h1>{t.title}</h1>
          <p class="intro">{t.intro}</p>
          <div class="direct"><h2>{t.directTitle}</h2><p>{t.directCopy}</p><a class="email" href="mailto:info@mysagra.com" data-umami-event="contact-email-click">info@mysagra.com</a></div>
          <p class="plans">{t.pricing} <a href={`${home}#solutions`}>{t.plans}</a></p>
        </div>
        <div class="form-surface"><ContactForm lang={lang} /></div>
      </div>
    </main>
    <Footer lang={lang} />
  </body>
</html>
<style>
  :global(body) { background: var(--color-surface); }
  .container { max-width: 71rem; margin-inline: auto; padding-inline: 1.5rem; }
  .skip-link { position: fixed; top: -6rem; left: 1rem; z-index: 100; padding: .75rem; background: var(--color-yellow); }
  .skip-link:focus { top: 1rem; }
  .breadcrumb { display: flex; gap: .75rem; font-size: .85rem; padding-top: 1.8rem; color: #52565e; }
  .contact-layout { display: grid; grid-template-columns: .85fr 1.15fr; gap: 4rem; padding-block: 3rem 5rem; align-items: start; }
  .copy { padding-top: 1rem; }
  h1 { font-size: clamp(2.3rem, 4vw, 3.5rem); line-height: 1.1; max-width: 13ch; }
  .intro { margin-top: 1.4rem; font-size: 1.15rem; color: #454950; }
  .direct { border-top: 1px solid var(--color-neutral-200); margin-top: 2.5rem; padding-top: 2rem; }
  h2 { font-size: 1.15rem; }
  .direct p { color: #454950; margin-top: .8rem; font-size: 1rem; }
  a { text-underline-offset: .22em; }
  .email { display: inline-block; font-weight: 600; margin-top: .65rem; padding-block: .5rem; }
  .plans { margin-top: 2rem; font-size: .95rem; color: #52565e; }
  .plans a { display: inline-block; font-weight: 600; padding-block: .5rem; }
  .form-surface { border: 1px solid var(--color-neutral-200); padding: 1.7rem; border-radius: var(--radius-lg); box-shadow: var(--shadow-soft); }
  .form-surface :global(form) { scroll-margin-top: 7rem; }
  @media (max-width: 800px) { .contact-layout { grid-template-columns: 1fr; gap: 2rem; } .copy { max-width: 42rem; } h1 { max-width: 19ch; } .direct { margin-top: 1.5rem; padding-top: 1.5rem; } }
  @media (max-width: 460px) { .container { padding-inline: 1.25rem; } .contact-layout { padding-top: 2rem; } .form-surface { padding: 1.1rem; } h1 { font-size: 2.4rem; } }
</style>
