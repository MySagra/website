---
import { getContent } from "../i18n/content";
import type { Lang } from "../i18n/ui";

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const b = getContent(lang).cookieBanner;
const privacyPolicyPath = lang === "en" ? "/en/privacy-policy/" : "/privacy-policy/";

const klaroConfig = {
	version: 2,
	default: false,
	storageMethod: "localStorage",
	cookieName: "klaro-consent-v2",
	cookieExpiresAfterDays: 365,
	privacyPolicy: privacyPolicyPath,
	mustConsent: false,
	acceptAll: true,
	groupByPurpose: false,
	hideDeclineAll: false,
	lang,
	translations: {
		[lang]: {
			consentNotice: { description: b.description, learnMore: b.learnMore },
			ok: b.acceptAll,
			acceptAll: b.acceptAll,
			decline: lang === "en" ? "Reject" : "Rifiuta",
			acceptSelected: b.savePreferences,
			save: b.savePreferences,
			consentModal: { title: b.modalTitle, description: b.modalDescription },
			"umami-replays": { description: b.replayDescription },
			purposes: {
				"session-replay": { title: lang === "en" ? "Session replay" : "Replay delle sessioni" },
			},
			privacyPolicy: {
				name: b.privacyPolicyName,
				text: lang === "en" ? "Read our {privacyPolicy}." : "Leggi la nostra {privacyPolicy}.",
			},
		},
	},
	services: [
		{
			name: "umami-replays",
			title: "Umami Session Replay",
			purposes: ["session-replay"],
			required: false,
			default: false,
		},
	],
};
---

<div id="klaro-config" data-config={JSON.stringify(klaroConfig)} hidden></div>
<script>
	const el = document.getElementById("klaro-config");
	const config = JSON.parse(el?.dataset.config || "{}");

	import("klaro").then((Klaro) => {
		let recorderStarted = false;
		config.services[0].callback = (consent: boolean) => {
			if (consent) recorderStarted = true;
			else if (recorderStarted) {
				// Removing the recorder script does not stop its active listeners.
				// Reload after Klaro saves the refusal to stop recording.
				setTimeout(() => window.location.reload(), 0);
			}
		};
		Klaro.setup(config);
		document.querySelectorAll("[data-open-privacy-settings]").forEach((button) => {
			button.addEventListener("click", () => Klaro.show(config));
		});
	});
</script>

<style is:global>
	.cookie-notice {
		font-family: var(--font-body);
		max-width: 22rem;
		background: var(--color-surface) !important;
		color: var(--color-ink) !important;
		border-radius: var(--radius-lg) !important;
		border: 1px solid var(--color-neutral-200);
		box-shadow: var(--shadow-lifted) !important;
		padding: 1.25rem !important;
		bottom: 1.1rem !important;
		left: 1.1rem !important;
		right: auto !important;
	}
	.cookie-notice .cn-body {
		font-size: 0.9rem !important;
		line-height: 1.5;
		color: var(--color-ink) !important;
	}
	.cookie-notice p,
	.cookie-notice h1,
	.cookie-notice h2,
	.cookie-notice ul,
	.cookie-notice li,
	.cookie-notice strong {
		color: var(--color-ink) !important;
	}
	.cookie-notice .cn-body p {
		margin: 0 0 0.9rem;
	}
	.cookie-notice .cn-ok {
		display: flex !important;
		gap: 0.6rem;
	}
	.cookie-notice a.cn-decline,
	.cookie-notice a.cn-learn-more,
	.cookie-notice .cm-link {
		color: var(--color-neutral-500) !important;
		font-size: 0.82rem !important;
		text-decoration: underline;
	}
	.cookie-notice a.cn-learn-more:hover {
		color: var(--color-ink) !important;
	}
	.cookie-notice button.cm-btn {
		font-family: var(--font-display) !important;
		font-weight: 700 !important;
		font-size: 0.85rem !important;
		border-radius: var(--radius-pill) !important;
		padding: 0.6rem 1.25rem !important;
		border: none !important;
		cursor: pointer;
		transition: opacity 0.15s ease;
	}
	.cookie-notice button.cm-btn:hover {
		opacity: 0.85;
	}
	.cookie-notice button.cm-btn-success {
		background: var(--color-yellow) !important;
		color: var(--color-ink) !important;
	}

	@media (max-width: 30rem) {
		.cookie-notice {
			left: 0.6rem !important;
			right: 0.6rem !important;
			bottom: 0.6rem !important;
			max-width: none;
		}
	}

	.klaro .cookie-modal {
		--dark1: var(--color-surface);
		--dark2: var(--color-neutral-200);
		--dark3: #454950;
		--light1: var(--color-ink);
		--light2: #454950;
		--light3: #454950;
		--green1: var(--color-yellow);
		--green2: var(--color-yellow);
		--white2: #d1d5db;
		--white3: var(--color-surface);
	}
	.klaro .cookie-modal .cm-modal.cm-klaro {
		width: calc(100% - 2rem);
		max-width: 36rem;
		max-height: calc(100dvh - 2rem);
		margin-inline: auto;
		font-family: var(--font-body);
		background: var(--color-surface);
		color: var(--color-ink);
		border-radius: var(--radius-lg);
		box-shadow: var(--shadow-lifted);
		overscroll-behavior: contain;
		scrollbar-color: #9ca3af var(--color-surface);
	}
	.klaro .cookie-modal .cm-modal.cm-klaro .cm-header,
	.klaro .cookie-modal .cm-modal.cm-klaro .cm-body,
	.klaro .cookie-modal .cm-modal.cm-klaro .cm-footer {
		padding: 1.5rem;
		border-color: var(--color-neutral-200);
	}
	.klaro .cookie-modal .cm-modal.cm-klaro .cm-header h1.title {
		max-width: calc(100% - 3rem);
		padding-right: 0;
		font-family: var(--font-display);
		font-size: clamp(1.45rem, 4vw, 1.8rem);
		font-weight: 700;
		line-height: 1.2;
		letter-spacing: -.02em;
	}
	.klaro .cookie-modal .cm-modal.cm-klaro .cm-header p {
		margin: 1rem 0 0;
		color: #454950;
		font-size: .95rem;
		line-height: 1.65;
	}
	.klaro .cookie-modal .cm-modal.cm-klaro a {
		color: var(--color-ink);
		text-decoration: underline;
		text-underline-offset: .2em;
	}
	.klaro .cookie-modal .cm-modal.cm-klaro .cm-body {
		background: var(--color-surface-warm);
	}
	.klaro .cookie-modal .cm-modal.cm-klaro .cm-body ul.cm-services li.cm-service {
		padding-left: 4.25rem;
	}
	.klaro .cookie-modal .cm-modal.cm-klaro .cm-body .cm-list-title {
		font-size: 1rem;
		font-weight: 600;
		line-height: 1.4;
	}
	.klaro .cookie-modal .cm-modal.cm-klaro .cm-body .cm-list-description {
		margin: .65rem 0 0;
		padding: 0;
		color: #454950;
		font-size: .9rem;
		line-height: 1.65;
	}
	.klaro .cookie-modal .cm-modal.cm-klaro .cm-body .purposes,
	.klaro .cookie-modal .cm-modal.cm-klaro .cm-btn-accept-all {
		display: none;
	}
	.klaro .cookie-modal .cm-modal.cm-klaro .cm-switch .slider {
		box-shadow: none;
		outline: 1px solid #9ca3af;
		outline-offset: 1px;
	}
	.klaro .cookie-modal .cm-modal.cm-klaro .cm-list-input:checked + .cm-list-label .slider {
		outline-color: var(--color-ink);
	}
	.klaro .cookie-modal .cm-modal.cm-klaro .cm-list-input:focus-visible + .cm-list-label .slider {
		outline: 2px solid var(--color-ink);
		outline-offset: 4px;
	}
	.klaro .cookie-modal .cm-modal.cm-klaro .cm-header button.hide {
		top: 1rem;
		right: 1rem;
		display: grid;
		place-items: center;
		width: 44px;
		height: 44px;
		padding: 0;
		border-radius: var(--radius-sm);
		color: var(--color-ink);
	}
	.klaro .cookie-modal .cm-modal.cm-klaro .cm-header button.hide:hover {
		background: var(--color-surface-warm);
	}
	.klaro .cookie-modal .cm-modal.cm-klaro .cm-footer-buttons {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: .75rem;
	}
	.klaro .cookie-modal .cm-modal.cm-klaro .cm-footer-buttons:has(button:only-child) {
		grid-template-columns: 1fr;
	}
	.klaro .cookie-modal .cm-modal.cm-klaro .cm-btn {
		margin: 0;
		min-height: 48px;
		padding: .8rem 1.2rem;
		border: 1px solid var(--color-neutral-200);
		border-radius: var(--radius-pill);
		font-family: var(--font-body);
		font-size: .95rem;
		font-weight: 600;
		line-height: 1.25;
		white-space: normal;
		cursor: pointer;
	}
	.klaro .cookie-modal .cm-modal.cm-klaro .cm-btn-decline {
		background: var(--color-surface);
		color: var(--color-ink);
	}
	.klaro .cookie-modal .cm-modal.cm-klaro .cm-btn-accept {
		background: var(--color-ink) !important;
		color: var(--color-surface) !important;
		border-color: var(--color-ink) !important;
	}
	.klaro .cookie-modal .cm-modal.cm-klaro .cm-btn-accept:hover {
		background: #2b2b2b !important;
	}
	.klaro .cookie-modal .cm-modal.cm-klaro .cm-btn:hover {
		border-color: var(--color-ink);
	}
	.klaro .cookie-modal .cm-modal.cm-klaro .cm-btn:disabled {
		cursor: wait;
		opacity: .6;
	}
	.klaro .cookie-modal .cm-modal.cm-klaro :is(button, a):focus-visible {
		outline: 2px solid var(--color-ink);
		outline-offset: 3px;
	}
	.klaro .cookie-modal .cm-modal.cm-klaro .cm-footer .cm-powered-by {
		padding: 0;
		margin: 1rem 0 0;
		font-size: .75rem;
	}
	.klaro .cookie-modal .cm-modal.cm-klaro .cm-footer .cm-powered-by a {
		color: #52565e;
	}
	@media (max-width: 30rem) {
		.klaro .cookie-modal .cm-modal.cm-klaro .cm-header,
		.klaro .cookie-modal .cm-modal.cm-klaro .cm-body,
		.klaro .cookie-modal .cm-modal.cm-klaro .cm-footer {
			padding: 1.25rem;
		}
		.klaro .cookie-modal .cm-modal.cm-klaro .cm-footer-buttons {
			grid-template-columns: 1fr;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.klaro .cookie-modal .cm-modal.cm-klaro .slider,
		.klaro .cookie-modal .cm-modal.cm-klaro .slider::before {
			transition: none;
		}
	}
</style>
