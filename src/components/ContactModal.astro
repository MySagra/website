---
import ContactForm from './ContactForm.astro';
import { getContactContent } from '../i18n/contact';
import type { Lang } from '../i18n/ui';
interface Props { lang: Lang; defaultSubject?: string; }
const { lang } = Astro.props;
const t = getContactContent(lang);
---
<dialog id="contact-dialog" class="rr-block" aria-labelledby="contact-title">
  <div class="sheet">
    <button type="button" class="close" id="contact-close" aria-label={t.close}><svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M2 2L16 16M16 2L2 16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></svg></button>
    <h2 id="contact-title">{t.title}</h2>
    <ContactForm lang={lang} />
  </div>
</dialog>
<style>
  dialog { border: 0; padding: 0; background: transparent; width: min(36rem, calc(100vw - 2rem)); max-width: none; max-height: calc(100dvh - 2rem); border-radius: var(--radius-lg); }
  dialog::backdrop { background: rgba(17,17,17,.55); }
  .sheet { position: relative; padding: 1.7rem; background: var(--color-surface); border-radius: var(--radius-lg); box-shadow: var(--shadow-lifted); max-height: calc(100dvh - 2rem); overflow-y: auto; scrollbar-color: #6b7280 #fafaf7; }
  .close { position: absolute; top: 1rem; right: 1rem; width: 44px; height: 44px; display: grid; place-items: center; border: 1px solid var(--color-neutral-200); border-radius: var(--radius); background: var(--color-surface); cursor: pointer; }
  .close:hover { border-color: var(--color-ink); }
  h2 { padding-right: 2.8rem; margin-bottom: .8rem; font-size: 1.6rem; line-height: 1.15; }
  @media (max-width: 460px) { .sheet { padding: 1.1rem; } h2 { font-size: clamp(1.15rem, 5.4vw, 1.3rem); margin-bottom: .9rem; } .close { top: .75rem; right: .75rem; } }
</style>
