				letter-spacing: 0.02em;
				padding: 0.3rem 0.7rem;
				border-radius: var(--radius-pill);
			}
			.tier h3 {
				font-size: 1.25rem;
				margin-bottom: 0.6rem;
			}
			.tier-desc {
				color: var(--color-neutral-500);
				font-size: 0.92rem;
				margin-bottom: 1.25rem;
			}
			.tier-points {
				list-style: none;
				margin: 0 0 1.25rem;
				padding: 0;
				display: grid;
				gap: 0.6rem;
			}
			.tier-points li {
				font-size: 0.88rem;
				padding-left: 1.5rem;
				position: relative;
			}
			.tier-points li::before {
				content: "";
				position: absolute;
				left: 0;
				top: 0.3rem;
				width: 1rem;
				height: 1rem;
				border-radius: 50%;
				background: rgba(254, 204, 1, 0.25);
			}
			.tier-points li::after {
				content: "";
				position: absolute;
				left: 0.32rem;
				top: 0.52rem;
				width: 0.36rem;
				height: 0.2rem;
				border-left: 1.5px solid var(--color-ink);
				border-bottom: 1.5px solid var(--color-ink);
				transform: rotate(-45deg);
			}
			.tier-warning {
				display: flex;
				align-items: flex-start;
				gap: 0.5rem;
				margin: 0 0 1.25rem;
				padding: 0.65rem 0.75rem;
				border-radius: var(--radius-sm);
				background: var(--color-surface-warm);
				font-size: 0.8rem;
				line-height: 1.4;
				color: var(--color-neutral-500);
			}
			.tier-warning svg {
				flex-shrink: 0;
				margin-top: 0.15rem;
				color: var(--color-ink);
			}
			.tier-cta {
				margin-top: auto;
				width: 100%;
				background: var(--color-ink);
				color: var(--color-surface);
				border: none;
				border-radius: var(--radius);
				padding: 0.8rem;
				font-weight: 600;
				font-size: 0.92rem;
				cursor: pointer;
				transition: opacity 0.15s ease;
			}
			.tier-cta:hover {
				opacity: 0.85;
			}
			.tier--featured .tier-cta {
				background: var(--color-yellow);
				color: var(--color-ink);
			}

			@media (max-width: 61rem) {
				.tiers {
					grid-template-columns: 1fr;
					max-width: 32rem;
				}
			}

			.solutions-demo-note {
				margin: clamp(2.5rem, 5vw, 3.5rem) auto 0;
				max-width: 68rem;
				text-align: center;
				font-size: 0.95rem;
				color: var(--color-neutral-500);
			}
			.link-btn-inline {
				background: none;
				border: none;
				padding: 0;
				font: inherit;
				color: var(--color-ink);
				font-weight: 600;
				text-decoration: underline;
				cursor: pointer;
			}

			/* ECOSISTEMA */
			.eco-rows {
				display: flex;
				flex-direction: column;
				gap: clamp(3rem, 6vw, 4.5rem);
				margin-top: 3rem;
			}
			.eco-row {
				display: flex;
				align-items: center;
				gap: clamp(2rem, 4vw, 3.5rem);
			}
			.eco-row--reverse {
				flex-direction: row-reverse;
			}
			/* MySagra's row: a distinct horizontal showcase panel — blueprint
			   grid backdrop running the full width of the screen, hub
			   diagram, text floating free of any icon. The margin trick
			   (not width:100vw + left:50%) breaks out of the section's
			   68rem container regardless of nesting: percentage margins
			   resolve against the parent's width while the vw half stays
			   tied to the true viewport, so the two offsets cancel out to
			   the viewport edge no matter how the ancestor is centered. */
			.eco-row--core {
				position: relative;
				margin-left: calc(50% - 50vw);
				margin-right: calc(50% - 50vw);
				padding: clamp(2rem, 4vw, 3rem) max(1.5rem, calc((100vw - 68rem) / 2 + 1.5rem));
				border-radius: 0;
				border-left: none;
				border-right: none;
				background-color: var(--color-surface-warm);
				background-image:
					linear-gradient(to right, rgba(17, 17, 17, 0.07) 1px, transparent 1px),
					linear-gradient(to bottom, rgba(17, 17, 17, 0.07) 1px, transparent 1px);
				background-size: 28px 28px;
				border-top: 1px solid var(--color-neutral-200);
				border-bottom: 1px solid var(--color-neutral-200);
				overflow: hidden;
			}
			/* Softens the grid toward the panel's center — a plain radial
			   overlay in the same surface color, not a mask: masking a
			   container that also holds animating transforms is a known
			   Chromium paint trap (see the earlier logos-strip note), so a
			   painted vignette gets the same fade without that risk. */
			.eco-row--core::after {
				content: "";
				position: absolute;
				inset: 0;
				background: radial-gradient(ellipse 65% 60% at 50% 50%, var(--color-surface-warm) 0%, transparent 72%);
				pointer-events: none;
			}
			.eco-row--core .eco-row-media,
			.eco-row--core .eco-row-text {
				position: relative;
				z-index: 1;
			}
			.eco-row--core .eco-row-text h3 {
				font-size: clamp(1.5rem, 2.6vw, 2rem);
			}
			.eco-row-media,
			.eco-row-text {
				flex: 1 1 0;
				min-width: 0;
			}
			/* aspect-ratio lives on this wrapper (a plain block), not on the
			   image element itself: replaced elements combine CSS aspect-ratio
			   with their own intrinsic width/height attributes in ways that
			   can silently win over the ratio once a flex/grid ancestor is
			   involved. A ratio-boxed wrapper + object-fit:cover on the image
			   is the version that can't drift off-square again. */
			.eco-row-media {
				position: relative;
				aspect-ratio: 1 / 1;
				border-radius: var(--radius-lg);
				overflow: hidden;
			}
			.eco-row-media img,
			.eco-hub,
			.eco-placeholder {
				width: 100%;
				height: 100%;
			}
			.eco-row-media img {
				object-fit: cover;
				display: block;
			}
			.eco-row-media--photo {
				box-shadow: var(--shadow-soft);
				border: 1px solid var(--color-neutral-200);
			}
			.eco-hub {
				position: relative;
				background: var(--color-surface-warm);
			}
			.eco-hub-lines {
				position: absolute;
				inset: 0;
				width: 100%;
				height: 100%;
			}
			/* Marching-ants flow along the connector lines: dasharray "2 2.4"
			   repeats every 4.4 units, so shifting by exactly 2x that (-8.8)
			   loops seamlessly with no visible jump between iterations. */
			.eco-hub-line {
				animation: eco-hub-line-flow 1.8s linear infinite;
			}
			@keyframes eco-hub-line-flow {
				to {
					stroke-dashoffset: -8.8;
				}
			}
			/* Centering uses a negative margin (not transform:translate) so
			   `transform` stays free for the float/hover animations below —
			   an animated transform always wins over a plain declared one,
			   so centering and motion can't share the same property. */
			.eco-hub-node {
				position: absolute;
				display: flex;
				align-items: center;
				justify-content: center;
				border-radius: 50%;
				background: var(--color-surface);
				border: 1px solid var(--color-neutral-200);
				color: var(--color-ink);
				box-shadow: var(--shadow-soft);
				text-decoration: none;
				transform: translate(var(--nx, 0px), var(--ny, 0px)) scale(var(--ns, 1));
				transition:
					box-shadow 0.2s ease,
					border-color 0.2s ease;
			}
			.eco-hub-node--center {
				width: 5.5rem;
				height: 5.5rem;
				left: 50%;
				top: 50%;
				margin: -2.75rem 0 0 -2.75rem;
				background: var(--color-yellow);
				border-color: var(--color-yellow);
				z-index: 2;
			}
			.eco-hub-node--center::before {
				content: "";
				position: absolute;
				inset: -0.85rem;
				border-radius: 50%;
				background: rgba(254, 204, 1, 0.4);
				z-index: -1;
				animation: eco-hub-glow-pulse 2.4s ease-in-out infinite;
			}
			@keyframes eco-hub-glow-pulse {
				0%,
				100% {
					transform: scale(0.85);
					opacity: 0.6;
				}
				50% {
					transform: scale(1.3);
					opacity: 0;
				}
			}
			.eco-hub-node--tl,
			.eco-hub-node--tr,
			.eco-hub-node--bl,
			.eco-hub-node--br {
				width: 3.75rem;
				height: 3.75rem;
				margin: -1.875rem 0 0 -1.875rem;
			}
			.eco-hub-node--tl {
				left: 17%;
				top: 20%;
			}
			.eco-hub-node--tr {
				left: 83%;
				top: 20%;
			}
			.eco-hub-node--bl {
				left: 17%;
				top: 80%;
			}
			.eco-hub-node--br {
				left: 83%;
				top: 80%;
			}
			.eco-hub-node:hover,
			.eco-hub-node:focus-visible {
				--ns: 1.16;
				box-shadow: var(--shadow-lifted);
				border-color: var(--color-yellow);
				z-index: 3;
				outline: none;
			}
			/* Custom dark-pill tooltip built from the anchor's own
			   data-tooltip attribute — no title attribute, so there's no
			   competing native browser tooltip on top of this one. */
			.eco-hub-node[data-tooltip]::after {
				content: attr(data-tooltip);
				position: absolute;
				bottom: 100%;
				left: 50%;
				margin-bottom: 0.65rem;
				transform: translate(-50%, 0.3rem);
				background: var(--color-ink);
				color: var(--color-surface);
				font-family: var(--font-body);
				font-size: 0.72rem;
				font-weight: 600;
				white-space: nowrap;
				padding: 0.4rem 0.8rem;
				border-radius: var(--radius-pill);
				box-shadow: var(--shadow-lifted);
				opacity: 0;
				pointer-events: none;
				transition:
					opacity 0.15s ease,
					transform 0.15s ease;
				z-index: 10;
			}
			.eco-hub-node[data-tooltip]:hover::after,
			.eco-hub-node[data-tooltip]:focus-visible::after {
				opacity: 1;
				transform: translate(-50%, 0);
			}
			/* Touch has no hover state to trigger this from, but a tap still
			   fires :focus-visible on the anchor — hide the pill outright on
			   touch-primary devices instead of leaving it stuck open. */
			@media (hover: none) {
				.eco-hub-node[data-tooltip]::after {
					display: none;
				}
			}
			.eco-row-media--hub {
				border: 1px solid var(--color-neutral-200);
			}
			/* Inside the grid panel the hub sits directly on the grid, not
			   on its own opaque tile — otherwise the diagram would blank
			   out the very backdrop it's meant to float over. */
			.eco-row--core .eco-row-media--hub {
				background: transparent;
				border: none;
			}
			.eco-row--core .eco-hub {
				background: transparent;
			}
			.eco-placeholder {
				display: flex;
				flex-direction: column;
				align-items: center;
				justify-content: center;
				gap: 0.6rem;
				background: var(--color-surface-warm);
				color: var(--color-neutral-500);
			}
			.eco-row-media--placeholder {
				border: 1px dashed var(--color-neutral-200);
			}
			.eco-placeholder span {
				font-size: 0.78rem;
			}

			/* PHONE MOCKUP (MyClienti) */
			.eco-row-media--phone {
				aspect-ratio: 4 / 5;
				border-radius: 0;
				overflow: visible;
				/* shared by .phone-frame's width and the badges' offsets below,
				   so the badges track the phone's actual clamped size at every
				   viewport instead of drifting into it at mid-widths, where the
				   container shrinks faster than the phone's own floor does. */
				--phone-w: clamp(10.5rem, 15vw, 13.5rem);
			}
			.phone-visual {
				position: absolute;
				inset: 0;
				display: flex;
				align-items: center;
				justify-content: center;
				z-index: 1;
			}
			.phone-mockup-glow {
				position: absolute;
				inset: -12%;
				background: radial-gradient(ellipse 60% 55% at 50% 40%, rgba(254, 204, 1, 0.4), transparent 68%);
				z-index: 0;
			}
			.phone-frame {
				position: relative;
				z-index: 1;
				display: flex;
				align-items: center;
				justify-content: center;
				width: var(--phone-w);
				aspect-ratio: 1170 / 2532;
				background: linear-gradient(155deg, #3a3a3f 0%, #1c1c1f 22%, #0a0a0c 55%, #1a1a1d 100%);
				border-radius: 2.6rem;
				padding: 0.4rem;
				box-shadow: var(--shadow-lifted), inset 0 0 0 1px rgba(255, 255, 255, 0.14);
				border: 1px solid rgba(0, 0, 0, 0.35);
				transform: rotate(-6deg);
			}
			/* side buttons: thin nubs on the frame's own edge give the
			   silhouette an actual iPhone read instead of a generic rounded
			   rectangle with a bezel. */
			.phone-btn {
				position: absolute;
				z-index: 0;
				width: 0.15rem;
				border-radius: 0.1rem 0 0 0.1rem;
				background: linear-gradient(90deg, #0a0a0c, #2a2a2e);
			}
			.phone-btn--mute {
				left: -0.13rem;
				top: 13%;
				height: 3%;
				border-radius: 0.1rem;
			}
			.phone-btn--vol-up {
				left: -0.13rem;
				top: 19.5%;
				height: 6.5%;
				border-radius: 0.1rem;
			}
			.phone-btn--vol-down {
				left: -0.13rem;
				top: 28%;
				height: 6.5%;
				border-radius: 0.1rem;
			}
			.phone-btn--power {
				right: -0.13rem;
				left: auto;
				top: 22%;
				height: 9%;
				border-radius: 0.1rem;
				background: linear-gradient(270deg, #0a0a0c, #2a2a2e);
			}
			.phone-notch {
				position: absolute;
				top: 1.15rem;
				left: 50%;
				transform: translateX(-50%);
				width: 30%;
				height: 1.9%;
				min-height: 0.42rem;
				border-radius: var(--radius-pill);
				background: #050506;
				box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.06);
				z-index: 3;
			}
			.phone-screen {
				position: relative;
				width: 100%;
				height: 100%;
				border-radius: 2.25rem;
				overflow: hidden;
				background: #fff;
			}
			/* screen box matches the screenshots' own ratio (1170x2532), so
			   cover alone has zero overflow to crop from. Shift the image
			   down (no scale) on purpose: opens breathing room under the
			   notch instead of the app header sitting flush against it;
			   the bottom just falls past the screen's own overflow:hidden. */
			.phone-screen-img {
				position: absolute;
				inset: 0;
				width: 100%;
				height: 100%;
				object-fit: cover;
				object-position: center top;
				transform: translateY(6%);
			}
			/* Two stacked images crossfade on a shared, complementary loop so
			   the swap always lands on a fully-resolved frame — never a
			   mid-fade blend — reinforcing "this is a deliberate skin change,"
			   not a glitch. Under reduced motion, global.css collapses this to
			   a single near-instant iteration that reverts to each image's
			   un-animated opacity (1); since --b paints after --a in the DOM,
			   it simply covers --a, so the fallback is a clean static frame,
			   not a flash of both images overlapping. */
			.phone-screen-img--a {
				animation: phone-crossfade-a 7s ease-in-out infinite;
			}
			.phone-screen-img--b {
				animation: phone-crossfade-b 7s ease-in-out infinite;
			}
			@keyframes phone-crossfade-a {
				0%,
				45% {
					opacity: 1;
				}
				50%,
				95% {
					opacity: 0;
				}
				100% {
					opacity: 1;
				}
			}
			@keyframes phone-crossfade-b {
				0%,
				45% {
					opacity: 0;
				}
				50%,
				95% {
					opacity: 1;
				}
				100% {
					opacity: 0;
				}
			}
			.phone-badge {
				position: absolute;
				z-index: 2;
				display: inline-flex;
				align-items: center;
				gap: 0.45rem;
				background: var(--color-surface);
				border: 1px solid var(--color-neutral-200);
				border-radius: var(--radius-pill);
				padding: 0.45rem 0.85rem 0.45rem 0.45rem;
				font-size: 0.78rem;
				font-weight: 600;
				color: var(--color-ink);
				box-shadow: var(--shadow-soft);
				white-space: nowrap;
			}
			.phone-badge-icon {
				display: inline-flex;
				align-items: center;
				justify-content: center;
				width: 1.55rem;
				height: 1.55rem;
				border-radius: 50%;
				background: rgba(254, 204, 1, 0.35);
				color: var(--color-ink);
				flex-shrink: 0;
			}
			.phone-badge--0 {
				top: 16%;
				right: calc(50% + var(--phone-w) / 2 + 1.3rem);
			}
			.phone-badge--1 {
				top: 24%;
				left: calc(50% + var(--phone-w) / 2 + 1.3rem);
			}
			.phone-badge--2 {
				top: 64%;
				right: calc(50% + var(--phone-w) / 2 + 1.3rem);
			}
			.phone-badge--3 {
				top: 70%;
				left: calc(50% + var(--phone-w) / 2 + 1.3rem);
			}

			/* Below this, the two-column row is still side-by-side (that
			   switch happens at 40rem), but the column itself is too narrow
			   for a flanking badge on top of a rotated phone without either
			   clipping at the row's outer edge or landing on the text
			   column — hide the flourish rather than crowd it. */
			@media (max-width: 64rem) {
				.phone-badge {
					display: none;
				}
			}
			@media (max-width: 40rem) {
				.eco-row-media--phone {
					aspect-ratio: 1 / 1;
				}
				.eco-row-media--phone .eco-row-icon-mobile {
					display: none;
				}
			}

			.eco-row-text .icon-badge {
				margin-bottom: 1rem;
			}
			.eco-row-icon-mobile {
				display: none;
			}
			.eco-row-text h3 {
				font-size: clamp(1.2rem, 2vw, 1.4rem);
				margin-bottom: 0.65rem;
			}
			.eco-row-text p {
				font-size: 1rem;
				color: var(--color-neutral-500);
				max-width: 30rem;
			}
			.eco-custom-note {
				margin-top: clamp(3rem, 6vw, 4rem);
				text-align: center;
				font-size: 0.95rem;
				color: var(--color-neutral-500);
			}
			.eco-custom-note a {
				color: var(--color-ink);
				font-weight: 600;
				text-decoration: underline;
			}

			@media (max-width: 40rem) {
				.eco-rows {
					gap: 2rem;
				}
				.eco-row,
				.eco-row--reverse {
					flex-direction: column;
					align-items: stretch;
					padding-bottom: 1.5rem;
					border-bottom: 1px solid var(--color-neutral-200);
				}
				.eco-row:last-child {
					padding-bottom: 0;
					border-bottom: none;
				}
				/* In row layout, flex:1 1 0 splits width evenly between media
				   and text. That same rule in a column stack would flex-grow
				   the media block along the now-vertical main axis, stretching
				   it tall and overriding its own aspect-ratio. Let it size by
				   its own square content on mobile instead. */
				.eco-row-media {
					flex: none;
				}
				.eco-row-text {
					flex: none;
				}
				.eco-row-icon-mobile {
					display: inline-flex;
					position: absolute;
					left: 0.6rem;
					bottom: 0.6rem;
					margin-bottom: 0;
					z-index: 2;
					background: var(--color-yellow);
					box-shadow: var(--shadow-lifted);
				}
				.eco-row-icon-desktop {
					display: none;
				}
			}

			/* CLOSING */
			.closing {
				padding: clamp(4rem, 8vw, 6rem) 1.5rem;
				background: var(--color-ink);
				display: flex;
				justify-content: center;
			}
			.closing-inner {
				text-align: center;
				max-width: 30rem;
				display: flex;
				flex-direction: column;
				align-items: center;
				gap: 0.9rem;
			}
			.closing-inner h2 {
				color: var(--color-surface);
				font-size: clamp(1.7rem, 3.4vw, 2.3rem);
			}
			.closing-inner p {
				color: var(--color-neutral-200);
			}
			.closing-inner .btn-primary {
				margin-top: 0.5rem;
			}
			.closing-note {
				margin-top: 1.75rem;
				padding-top: 1.5rem;
				border-top: 1px solid rgba(255, 255, 255, 0.12);
				font-size: 0.85rem;
				color: var(--color-neutral-200);
				opacity: 0.75;
			}
			.closing-note a {
				color: var(--color-surface);
				text-decoration: underline;
			}

			/* STORY */
			.story {
				padding: clamp(4rem, 8vw, 6rem) 1.5rem;
				max-width: 56rem;
				margin: 0 auto;
			}
			.story-inner {
				display: grid;
				grid-template-columns: 12rem 1fr;
				gap: 2.5rem;
				align-items: center;
			}
			.story-photo {
				aspect-ratio: 1;
				border-radius: var(--radius-lg);
				border: 1px dashed var(--color-neutral-200);
				display: flex;
				flex-direction: column;
				align-items: center;
				justify-content: center;
				gap: 0.6rem;
				color: var(--color-neutral-500);
			}
			.story-photo span {
