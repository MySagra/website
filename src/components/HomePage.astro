				/* Spacing lives on each item (not a flex `gap` on the track),
				   so the two duplicated halves are byte-identical units with
				   no "connector" gap to compensate for. That makes a plain
				   translateX(-50%) exactly seamless — no fudge-factor math
				   that can drift out of sync and show as a stutter. */
				padding: 0 1.25rem;
			}
			@keyframes logos-scroll {
				from {
					transform: translateX(0);
				}
				to {
					/* 3 identical copies in the track (see markup): shift by
					   one copy's width (1/3 of total), not by half. Looping
					   at -50% here would stop mid-way through the 2nd copy,
					   landing on a different item than the start — a visible
					   jump/stutter every loop instead of a seamless one. */
					transform: translateX(-33.3333%);
