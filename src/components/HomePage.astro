---
import "@fontsource/inter/600.css";
import "@fontsource/inter/700.css";
import "@fontsource/inter/800.css";
import "@fontsource/work-sans/400.css";
import "@fontsource/work-sans/500.css";
import "@fontsource/work-sans/600.css";
import "@fontsource/work-sans/700.css";
import "../styles/global.css";
import Header from "./Header.astro";
import ContactModal from "./ContactModal.astro";
import Logo from "./Logo.astro";
import Analytics from "./Analytics.astro";
import { getContent } from "../i18n/content";
import type { Lang } from "../i18n/ui";

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = getContent(lang);
const outcomes = t.outcomes;
const ecosystem = t.ecosistema.items;
const tiers = t.soluzioni.tiers;
const faqItems = t.faq.items;

const SITE_URL = "https://mysagra.com";
const path = lang === "en" ? "/en/" : "/";
const canonicalUrl = `${SITE_URL}${path}`;
const ogImageUrl = `${SITE_URL}/images/mycassa-terminal.webp`;
const ogLocale = lang === "en" ? "en_US" : "it_IT";
const ogLocaleAlternate = lang === "en" ? "it_IT" : "en_US";

const organizationSchema = {
	"@context": "https://schema.org",
	"@type": "Organization",
	name: "MySagra",
	url: SITE_URL,
	logo: `${SITE_URL}/favicon.svg`,
	description: t.meta.description,
	sameAs: ["https://github.com/mysagra"],
};

const softwareSchema = {
	"@context": "https://schema.org",
	"@type": "SoftwareApplication",
	name: "MySagra",
	applicationCategory: "BusinessApplication",
	operatingSystem: "Web",
	url: canonicalUrl,
	description: t.meta.description,
	inLanguage: lang,
	keywords: t.meta.keywords,
};

const faqSchema = {
	"@context": "https://schema.org",
	"@type": "FAQPage",
	mainEntity: faqItems.map((item) => ({
		"@type": "Question",
		name: item.q,
		acceptedAnswer: { "@type": "Answer", text: item.a },
	})),
};

const partnerLogos = ["FOLLOW THE SUN", "INSIEME IN FESTA", "NOI CON VOI NOI PER VOI", "SANROCK"];

const icons: Record<string, string> = {
	receipt:
		'<path d="M5 3h10v14l-2-1-2 1-2-1-2 1-2-1V3Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><path d="M7.5 7.5h5M7.5 10.5h5M7.5 13.5h3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>',
	wifi: '<path d="M4 7.8a9 9 0 0 1 12 0" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><path d="M6.5 10.8a5.4 5.4 0 0 1 7 0" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><circle cx="10" cy="14" r="1.1" fill="currentColor"/>',
	chart:
		'<path d="M3.5 13.5 8 9l3 3 5.5-6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/><path d="M12.5 6h4v4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>',
	shield:
		'<path d="M2.5 10.5h3l1.4-3.6 2.6 7 1.4-3.4h6.6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>',
	history:
		'<ellipse cx="10" cy="5.3" rx="5.8" ry="2.1" stroke="currentColor" stroke-width="1.5"/><path d="M4.2 5.3v9.4c0 1.16 2.6 2.1 5.8 2.1s5.8-.94 5.8-2.1V5.3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><path d="M4.2 10c0 1.16 2.6 2.1 5.8 2.1s5.8-.94 5.8-2.1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>',
	plug: '<path d="M6 7.8V4.3h8v3.5" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><rect x="3.5" y="7.8" width="13" height="5.6" rx="1.3" stroke="currentColor" stroke-width="1.5"/><path d="M6 13.4h8v2.9H6v-2.9Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><circle cx="13.7" cy="10.5" r="0.55" fill="currentColor"/>',
	core: '<rect x="3.5" y="3.5" width="13" height="13" rx="2.5" stroke="currentColor" stroke-width="1.5"/><path d="M7 10h6M10 7v6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>',
	cassa:
		'<rect x="3.5" y="6" width="13" height="10" rx="1.8" stroke="currentColor" stroke-width="1.5"/><path d="M3.5 9.5h13" stroke="currentColor" stroke-width="1.5"/><path d="M7 4h6l1 2H6l1-2Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>',
	stampa:
		'<path d="M6 8V4h8v4" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><rect x="3.5" y="8" width="13" height="6" rx="1.5" stroke="currentColor" stroke-width="1.5"/><path d="M6 13h8v4H6v-4Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>',
	numeri:
		'<rect x="3.5" y="4.5" width="13" height="9" rx="1.5" stroke="currentColor" stroke-width="1.5"/><path d="M7.5 17h5M10 13.5V17" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><path d="M7 9.2h1.4M11.6 9.2H13" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>',
	clienti:
		'<rect x="4.5" y="2.5" width="11" height="15" rx="2" stroke="currentColor" stroke-width="1.5"/><path d="M8 15.2h4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>',
	cloud:
		'<path d="M6.5 15.5a3.5 3.5 0 0 1 .6-6.95A5 5 0 0 1 17 10a3.5 3.5 0 0 1-.9 6.9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>',
	onsite:
		'<path d="M3.5 9.5 10 4l6.5 5.5M5 8.5v7.5h10V8.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>',
	custom:
		'<path d="M13.2 3.8a2.4 2.4 0 0 1 3.4 3.4l-8 8-4 1 1-4 7.6-8.4Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>',
	cpu: '<rect x="6" y="6" width="8" height="8" rx="1" stroke="currentColor" stroke-width="1.5"/><path d="M8 6V3M12 6V3M8 17v-3M12 17v-3M6 8H3M6 12H3M17 8h-3M17 12h-3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>',
	palette:
		'<path d="M10 2.5a7.5 7.5 0 1 0 0 15c.9 0 1.6-.72 1.6-1.6 0-.42-.16-.8-.43-1.08-.27-.28-.42-.63-.42-1.02 0-.88.71-1.6 1.6-1.6h1.85A3.6 3.6 0 0 0 18 8.6C18 5.06 14.42 2.5 10 2.5Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><circle cx="6.4" cy="9.2" r="1" fill="currentColor"/><circle cx="8.6" cy="6.1" r="1" fill="currentColor"/><circle cx="12.2" cy="6.2" r="1" fill="currentColor"/><circle cx="14.2" cy="9.4" r="1" fill="currentColor"/>',
	calendar:
		'<rect x="3.5" y="4.5" width="13" height="12" rx="1.5" stroke="currentColor" stroke-width="1.5"/><path d="M3.5 8h13" stroke="currentColor" stroke-width="1.5"/><path d="M7 3v3M13 3v3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>',
	star: '<path d="M10 2.8 12 6.7l4.3.6-3.1 3 .73 4.3L10 12.6l-3.85 2.02.73-4.3-3.1-3.02 4.3-.6L10 2.8Z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/>',
	layout:
		'<rect x="3" y="3" width="6" height="6" rx="1.3" stroke="currentColor" stroke-width="1.5"/><rect x="11" y="3" width="6" height="6" rx="1.3" stroke="currentColor" stroke-width="1.5"/><rect x="3" y="11" width="6" height="6" rx="1.3" stroke="currentColor" stroke-width="1.5"/><rect x="11" y="11" width="6" height="6" rx="1.3" stroke="currentColor" stroke-width="1.5"/>',
	image:
		'<rect x="3.5" y="4" width="13" height="12" rx="1.5" stroke="currentColor" stroke-width="1.5"/><circle cx="7.2" cy="8" r="1.3" stroke="currentColor" stroke-width="1.5"/><path d="M4 13.5 8 10l2.5 2 3-3.2L16.5 13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>',
};
---

<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content="#FECC01" />
		<title>{t.meta.title}</title>
		<meta name="description" content={t.meta.description} />
		<meta name="keywords" content={t.meta.keywords} />

		<link rel="canonical" href={canonicalUrl} />
		<link rel="alternate" hreflang="it" href={`${SITE_URL}/`} />
		<link rel="alternate" hreflang="en" href={`${SITE_URL}/en/`} />
		<link rel="alternate" hreflang="x-default" href={`${SITE_URL}/`} />

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="MySagra" />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:title" content={t.meta.title} />
		<meta property="og:description" content={t.meta.description} />
		<meta property="og:image" content={ogImageUrl} />
		<meta property="og:image:width" content="1082" />
		<meta property="og:image:height" content="630" />
		<meta property="og:locale" content={ogLocale} />
		<meta property="og:locale:alternate" content={ogLocaleAlternate} />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={t.meta.title} />
		<meta name="twitter:description" content={t.meta.description} />
		<meta name="twitter:image" content={ogImageUrl} />

		<script type="application/ld+json" is:inline set:html={JSON.stringify(organizationSchema)} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(softwareSchema)} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
		<Analytics lang={lang} />
	</head>
	<body>
		<!--
			THESIS: Modern SaaS, played straight — the category standard at full
			craft, not a rolled distinctive world. User-pinned canon: Toast POS /
			Square / Lightspeed.
			OWN-WORLD: white/off-white ground, ink #111111 text, brand yellow
			#FECC01 as the confident single accent (buttons, icon-badge tints, a
			soft glow behind the hero screenshot) — never a full-bleed background.
			Rounded system throughout: 12px cards/inputs, 20px large frames, pill
			CTAs. Soft lifted shadows on product screenshots. Inter for headings
			(client-pinned, also the real modern-SaaS default), Work Sans body.
			Icon-badge feature grids and a real product screenshot in the hero —
			both load-bearing Toast/Square conventions, earned by the named canon.
			STORY: a pro loco organizer recognizes the register instantly — "this
			looks like real software" — and trusts it enough to ask for pricing.
			FIRST VIEWPORT: centered headline + dek + two CTAs, a large real
			MyCassa screenshot below in a rounded lifted frame with a soft yellow
			glow, logo trust bar underneath.
			FORM: canon, not a rolled direction — user explicitly asked for the
			category standard ("voglio qualcosa di moderno da SaaS"), confirmed
			craft bar Toast POS / Square / Lightspeed. Supersedes Bacheca (seed
			25600760) and Il Menu del Giorno (seed 0f903a0a), both explicitly
			rejected by the client in this session.
			FINISH: unreviewed and undocumented is unfinished; this build ends
			with the finish review, the verdict, and DESIGN.md.
		-->
		<Header lang={lang} />

		<main id="top">
			<!-- HERO -->
			<section class="hero">
				<div class="hero-bg" aria-hidden="true">
					<svg class="hero-wave" viewBox="0 0 1440 140" preserveAspectRatio="none">
						<path
							d="M0,80 C240,140 480,20 720,50 C960,80 1200,140 1440,70 L1440,140 L0,140 Z"
							fill="var(--color-surface)"
						/>
					</svg>
				</div>

				<div class="hero-copy">
					<h1>{t.hero.h1Line1} <br />{t.hero.h1Line2}</h1>
					<p class="dek">{t.hero.dek}</p>
					<div class="hero-actions">
						<button type="button" class="btn-primary" data-open-contact="informazioni" data-umami-event="contact-open" data-umami-event-location="hero-primary">{t.hero.ctaPrimary}</button>
						<a href="#solutions" class="btn-secondary" title={lang === "en" ? "Jump to the Plans section" : "Vai alla sezione Soluzioni"} data-umami-event="nav-click" data-umami-event-section="solutions" data-umami-event-location="hero-secondary">{t.hero.ctaSecondary}</a>
					</div>
				</div>

				<div class="hero-showcase">
					<figure class="hero-image">
						<img
							src="/images/mycassa-terminal.webp"
							alt={t.hero.heroImgAlt}
							loading="eager"
							width="1082"
							height="630"
						/>
					</figure>
				</div>

				<div class="logos-strip">
					<p class="logos-label">{t.hero.logosLabel}</p>
					<div class="logos-track-wrap">
						<div class="logos-fade logos-fade--left" aria-hidden="true"></div>
						<ul class="logos-track" aria-hidden="true">
							{partnerLogos.map((label) => <li>{label}</li>)}
							{partnerLogos.map((label) => <li>{label}</li>)}
							{partnerLogos.map((label) => <li>{label}</li>)}
						</ul>
						<div class="logos-fade logos-fade--right" aria-hidden="true"></div>
					</div>
				</div>
			</section>

			<!-- VANTAGGI -->
			<section id="benefits" class="section">
				<div class="section-head">
					<h2>{t.vantaggi.h2}</h2>
				</div>
				<div class="feature-grid">
					{
						outcomes.map((item) => (
							<div class="feature-card" data-reveal>
								<span class="icon-badge" aria-hidden="true" set:html={`<svg width="20" height="20" viewBox="0 0 20 20" fill="none">${icons[item.icon]}</svg>`} />
								<h3>{item.title}</h3>
								<p>{item.desc}</p>
							</div>
						))
					}
				</div>
			</section>

			<!-- SOLUZIONI -->
			<section id="solutions" class="section section--muted">
				<div class="section-head">
					<h2>{t.soluzioni.h2}</h2>
					<p class="section-lede">{t.soluzioni.lede}</p>
				</div>

				<div class="tiers">
					{
						tiers.map((tier) => (
							<div class:list={["tier", { "tier--featured": tier.featured }]} data-reveal>
								{tier.tag && <span class="tier-tag">{tier.tag}</span>}
								<span
									class="icon-badge"
									aria-hidden="true"
									set:html={`<svg width="20" height="20" viewBox="0 0 20 20" fill="none">${icons[tier.icon]}</svg>`}
								/>
								<h3>{tier.name}</h3>
								<p class="tier-desc">{tier.desc}</p>
								<ul class="tier-points">
									{tier.points.map((point) => (
										<li>{point}</li>
									))}
								</ul>
								{tier.warning && (
									<p class="tier-warning">
										<svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
											<path
												d="M8 1.5 15 14H1L8 1.5Z"
												stroke="currentColor"
												stroke-width="1.3"
												stroke-linejoin="round"
											/>
											<path d="M8 6.2v3.4M8 11.6v.1" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" />
										</svg>
										{tier.warning}
									</p>
								)}
								<button
									type="button"
									class="tier-cta"
									data-open-contact="informazioni"
									data-request-type={tier.icon}
									data-umami-event="tier-cta-click"
									data-umami-event-tier={tier.name}
								>
									{tier.cta}
								</button>
							</div>
						))
					}
				</div>

				<p class="solutions-demo-note">
					{t.soluzioni.demoNotePrefix}{" "}
					<button
						type="button"
						class="link-btn-inline"
						data-open-contact="informazioni"
						data-request-type="demo"
						data-umami-event="contact-open"
						data-umami-event-location="solutions-demo-note"
					>
						{t.soluzioni.demoNoteCta}
					</button>
				</p>
			</section>

			<!-- ECOSISTEMA -->
			<section id="ecosystem" class="section">
				<div class="section-head">
					<h2>{t.ecosistema.h2}</h2>
					<p class="section-lede">{t.ecosistema.lede}</p>
				</div>

				<div class="eco-rows">
					{
						ecosystem.map((item, i) => (
							<div
							id={`eco-${item.role}`}
							class:list={["eco-row", { "eco-row--reverse": i % 2 === 1, "eco-row--core": item.role === "core" }]}
							data-reveal
						>
								<div
									class:list={[
										"eco-row-media",
										item.role === "core"
										? "eco-row-media--hub"
										: item.photos
											? "eco-row-media--phone"
											: item.photo
												? "eco-row-media--photo"
												: "eco-row-media--placeholder",
									]}
								>
									{item.role !== "core" && (
										<span
											class="icon-badge eco-row-icon-mobile"
											aria-hidden="true"
											set:html={`<svg width="20" height="20" viewBox="0 0 20 20" fill="none">${icons[item.icon]}</svg>`}
										/>
									)}
									{item.role === "core" ? (
										<div class="eco-hub">
											<svg class="eco-hub-lines" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
												<line class="eco-hub-line" x1="50" y1="50" x2="17" y2="20" stroke="var(--color-ink)" stroke-width="0.6" stroke-dasharray="2 2.4" opacity="0.3" />
												<line class="eco-hub-line" x1="50" y1="50" x2="83" y2="20" stroke="var(--color-ink)" stroke-width="0.6" stroke-dasharray="2 2.4" opacity="0.3" />
												<line class="eco-hub-line" x1="50" y1="50" x2="17" y2="80" stroke="var(--color-ink)" stroke-width="0.6" stroke-dasharray="2 2.4" opacity="0.3" />
												<line class="eco-hub-line" x1="50" y1="50" x2="83" y2="80" stroke="var(--color-ink)" stroke-width="0.6" stroke-dasharray="2 2.4" opacity="0.3" />
											</svg>
											<a
												href="#eco-core"
												class="eco-hub-node eco-hub-node--center"
												aria-label={t.ecosistema.items.find((it) => it.role === "core")?.name}
												data-tooltip={t.ecosistema.items.find((it) => it.role === "core")?.name}
												data-umami-event="ecosystem-hub-click"
												data-umami-event-node="core"
											>
												<Logo width={52} height={52} markColor="#111111" groundColor="transparent" decorative />
											</a>
											<a
												href="#eco-cassa"
												class="eco-hub-node eco-hub-node--tl"
												aria-label={t.ecosistema.items.find((it) => it.role === "cassa")?.name}
												data-tooltip={t.ecosistema.items.find((it) => it.role === "cassa")?.name}
												data-umami-event="ecosystem-hub-click"
												data-umami-event-node="cassa"
												set:html={`<svg width="30" height="30" viewBox="0 0 20 20" fill="none">${icons.cassa}</svg>`}
											/>
											<a
												href="#eco-display"
												class="eco-hub-node eco-hub-node--tr"
												aria-label={t.ecosistema.items.find((it) => it.role === "display")?.name}
												data-tooltip={t.ecosistema.items.find((it) => it.role === "display")?.name}
												data-umami-event="ecosystem-hub-click"
												data-umami-event-node="display"
												set:html={`<svg width="30" height="30" viewBox="0 0 20 20" fill="none">${icons.numeri}</svg>`}
											/>
											<a
												href="#eco-stampa"
												class="eco-hub-node eco-hub-node--bl"
												aria-label={t.ecosistema.items.find((it) => it.role === "stampa")?.name}
												data-tooltip={t.ecosistema.items.find((it) => it.role === "stampa")?.name}
												data-umami-event="ecosystem-hub-click"
												data-umami-event-node="stampa"
												set:html={`<svg width="30" height="30" viewBox="0 0 20 20" fill="none">${icons.stampa}</svg>`}
											/>
											<a
												href="#eco-cliente"
												class="eco-hub-node eco-hub-node--br"
												aria-label={t.ecosistema.items.find((it) => it.role === "cliente")?.name}
												data-tooltip={t.ecosistema.items.find((it) => it.role === "cliente")?.name}
												data-umami-event="ecosystem-hub-click"
												data-umami-event-node="cliente"
												set:html={`<svg width="30" height="30" viewBox="0 0 20 20" fill="none">${icons.clienti}</svg>`}
											/>
										</div>
									) : item.photos ? (
										<>
											<div class="phone-visual" role="img" aria-label={t.ecosistema.personalize.alt}>
												<div class="phone-mockup-glow" aria-hidden="true" />
												<div class="phone-frame">
													<div class="phone-btn phone-btn--mute" aria-hidden="true" />
													<div class="phone-btn phone-btn--vol-up" aria-hidden="true" />
													<div class="phone-btn phone-btn--vol-down" aria-hidden="true" />
													<div class="phone-btn phone-btn--power" aria-hidden="true" />
													<div class="phone-notch" aria-hidden="true" />
													<div class="phone-screen">
														<img
															class="phone-screen-img phone-screen-img--a"
															src={item.photos[0]}
															alt=""
															aria-hidden="true"
															loading="lazy"
															width="1170"
															height="2532"
														/>
														<img
