		<script>
			// The browser's native scroll-to-#hash-on-load runs before web fonts swap
			// in (layout is shorter than the final one) and lands under the sticky
			// header regardless — re-measure by hand once fonts have settled.
			if (location.hash) {
				const hashTarget = document.querySelector(location.hash);
				if (hashTarget) {
					const realign = () => {
						const header = document.querySelector(".site-header");
						const offset = (header?.getBoundingClientRect().height ?? 0) + 16;
						const top = hashTarget.getBoundingClientRect().top + window.scrollY - offset;
						window.scrollTo(0, Math.max(0, top));
					};
					window.addEventListener("load", realign, { once: true });
					document.fonts?.ready?.then(realign);
				}
			}

			const io = new IntersectionObserver(
				(entries) => {
					for (const entry of entries) {
						if (entry.isIntersecting) {
							entry.target.classList.add("is-visible");
							io.unobserve(entry.target);
						}
					}
				},
				{ threshold: 0.2, rootMargin: "0px 0px -6% 0px" },
			);
			document.querySelectorAll("[data-reveal]").forEach((el, i) => {
				(el as HTMLElement).style.transitionDelay = `${Math.min(i % 3, 2) * 70}ms`;
				io.observe(el);
			});

			interface HubNode {
				el: HTMLElement;
				isCorner: boolean;
				frac: { x: number; y: number } | null;
				amp: number;
				phase: number;
				x: number;
				y: number;
				basePx: { x: number; y: number };
			}

			const CORNER_FRACTIONS: Record<string, { x: number; y: number }> = {
				"eco-hub-node--tl": { x: 0.17, y: 0.2 },
				"eco-hub-node--tr": { x: 0.83, y: 0.2 },
				"eco-hub-node--bl": { x: 0.17, y: 0.8 },
				"eco-hub-node--br": { x: 0.83, y: 0.8 },
			};
			// Only a corner node within this pixel radius of the pointer
			// reacts, and only the single nearest one — the rest stay put.
			const REACT_RADIUS = 110;

			const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

			document.querySelectorAll<HTMLElement>(".eco-hub").forEach((hub) => {
				let pointerPx: { x: number; y: number } | null = null;

				hub.addEventListener("pointermove", (event) => {
					const rect = hub.getBoundingClientRect();
					pointerPx = { x: event.clientX - rect.left, y: event.clientY - rect.top };
				});
				hub.addEventListener("pointerleave", () => {
					pointerPx = null;
				});

				if (prefersReducedMotion) return;

				const nodes: HubNode[] = Array.from(hub.querySelectorAll<HTMLElement>(".eco-hub-node")).map((el, i) => {
					const fracEntry = Object.entries(CORNER_FRACTIONS).find(([cls]) => el.classList.contains(cls));
					return {
						el,
						isCorner: !!fracEntry,
						frac: fracEntry ? fracEntry[1] : null,
						amp: fracEntry ? 9 : 3,
						phase: i * 1.3,
						x: 0,
						y: 0,
						basePx: { x: 0, y: 0 },
					};
				});
				const cornerNodes = nodes.filter((node) => node.isCorner);

				function tick(t: number) {
					let nearest: HubNode | null = null;
					let nearestDist = Infinity;

					if (pointerPx) {
						const rect = hub.getBoundingClientRect();
						for (const node of cornerNodes) {
							if (!node.frac) continue;
							node.basePx = { x: node.frac.x * rect.width, y: node.frac.y * rect.height };
							const dist = Math.hypot(pointerPx.x - node.basePx.x, pointerPx.y - node.basePx.y);
							if (dist < nearestDist) {
								nearestDist = dist;
								nearest = node;
							}
						}
					}

					for (const node of nodes) {
						const idleX = Math.sin(t / 1400 + node.phase) * node.amp;
						const idleY = Math.cos(t / 1100 + node.phase) * node.amp * 0.6;
						let magnetX = 0;
						let magnetY = 0;
						if (node === nearest && pointerPx && nearestDist < REACT_RADIUS) {
							const pull = 1 - nearestDist / REACT_RADIUS;
							magnetX = (pointerPx.x - node.basePx.x) * 0.35 * pull;
							magnetY = (pointerPx.y - node.basePx.y) * 0.35 * pull;
						}
						node.x += (idleX + magnetX - node.x) * 0.08;
						node.y += (idleY + magnetY - node.y) * 0.08;
						node.el.style.setProperty("--nx", `${node.x.toFixed(2)}px`);
						node.el.style.setProperty("--ny", `${node.y.toFixed(2)}px`);
					}
					requestAnimationFrame(tick);
				}
				requestAnimationFrame(tick);
			});
		</script>

