---
import Logo from "./Logo.astro";
import { getContent } from "../i18n/content";
import type { Lang } from "../i18n/ui";

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = getContent(lang);
---

<header class="site-header">
	<div class="inner">
		<a href="#top" class="brand" title={lang === "en" ? "MySagra – back to homepage" : "MySagra – torna alla home"}>
			<Logo width={30} height={30} decorative />
			<span>MySagra</span>
		</a>

		<nav class="nav-desktop" aria-label={t.header.sectionsAria}>
			<a href="#benefits" title={lang === "en" ? "Jump to the Benefits section" : "Vai alla sezione Vantaggi"} data-umami-event="nav-click" data-umami-event-section="benefits" data-umami-event-location="header">{t.header.nav.vantaggi}</a>
			<a href="#solutions" title={lang === "en" ? "Jump to the Plans section" : "Vai alla sezione Soluzioni"} data-umami-event="nav-click" data-umami-event-section="solutions" data-umami-event-location="header">{t.header.nav.soluzioni}</a>
			<a href="#ecosystem" title={lang === "en" ? "Jump to the Ecosystem section" : "Vai alla sezione Ecosistema"} data-umami-event="nav-click" data-umami-event-section="ecosystem" data-umami-event-location="header">{t.header.nav.ecosistema}</a>
			<a href="https://docs.mysagra.com" target="_blank" rel="noopener" title={lang === "en" ? "Open MySagra documentation (new tab)" : "Apri la documentazione MySagra (nuova scheda)"} data-umami-event="docs-click" data-umami-event-location="header">{t.header.nav.docs}</a>
		</nav>

		<div class="actions">
			<button type="button" class="cta" data-open-contact="informazioni" data-umami-event="contact-open" data-umami-event-location="header">{t.header.cta}</button>
			<button
				type="button"
				class="menu-toggle"
				id="menu-toggle"
				aria-expanded="false"
				aria-controls="mobile-nav"
				aria-label={t.header.menuOpenAria}
			>
				<svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true" class="icon-open">
					<path d="M3 5h14M3 10h14M3 15h14" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
				</svg>
				<svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true" class="icon-close">
					<path d="M4 4l12 12M16 4 4 16" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
				</svg>
			</button>
		</div>
	</div>

	<nav id="mobile-nav" class="nav-mobile" aria-label={t.header.sectionsAria} hidden>
		<a href="#benefits" title={lang === "en" ? "Jump to the Benefits section" : "Vai alla sezione Vantaggi"} data-umami-event="nav-click" data-umami-event-section="benefits" data-umami-event-location="header-mobile"><span>{t.header.nav.vantaggi}</span></a>
		<a href="#solutions" title={lang === "en" ? "Jump to the Plans section" : "Vai alla sezione Soluzioni"} data-umami-event="nav-click" data-umami-event-section="solutions" data-umami-event-location="header-mobile"><span>{t.header.nav.soluzioni}</span></a>
		<a href="#ecosystem" title={lang === "en" ? "Jump to the Ecosystem section" : "Vai alla sezione Ecosistema"} data-umami-event="nav-click" data-umami-event-section="ecosystem" data-umami-event-location="header-mobile"><span>{t.header.nav.ecosistema}</span></a>
		<a href="https://docs.mysagra.com" target="_blank" rel="noopener" title={lang === "en" ? "Open MySagra documentation (new tab)" : "Apri la documentazione MySagra (nuova scheda)"} data-umami-event="docs-click" data-umami-event-location="header-mobile"><span>{t.header.nav.docs}</span></a>
	</nav>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 40;
		background: var(--color-surface);
		border-bottom: 1px solid var(--color-neutral-200);
	}

	.inner {
		max-width: 68rem;
		margin: 0 auto;
		padding: 1rem 1.5rem;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
	}

	.brand {
		display: flex;
		align-items: center;
		gap: 0.55rem;
		text-decoration: none;
		color: var(--color-ink);
		font-family: var(--font-display);
		font-weight: 700;
		font-size: 1.1rem;
		letter-spacing: -0.01em;
	}

	.nav-desktop {
		display: flex;
		gap: 2rem;
		margin-right: auto;
	}
	.nav-desktop a {
		text-decoration: none;
		font-size: 0.9rem;
		font-weight: 500;
		color: var(--color-ink);
		opacity: 0.65;
	}
	.nav-desktop a:hover {
		opacity: 1;
	}

	.actions {
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}

	.cta {
		background: var(--color-yellow);
		color: var(--color-ink);
		border: none;
		border-radius: var(--radius-pill);
		padding: 0.65rem 1.3rem;
		font-weight: 700;
		font-size: 0.88rem;
		cursor: pointer;
		white-space: nowrap;
		transition:
			transform 0.15s ease,
			box-shadow 0.15s ease;
	}
	.cta:hover {
		transform: translateY(-1px);
		box-shadow: var(--shadow-soft);
	}

	.menu-toggle {
		display: none;
		align-items: center;
		justify-content: center;
		width: 2.3rem;
		height: 2.3rem;
		flex-shrink: 0;
		border: 1px solid var(--color-neutral-200);
		border-radius: var(--radius-sm);
		background: var(--color-surface);
		color: var(--color-ink);
		cursor: pointer;
		transition: border-color 0.15s ease;
	}
	.menu-toggle:hover {
		border-color: var(--color-ink);
	}
	.menu-toggle .icon-close {
		display: none;
	}
	.menu-toggle[aria-expanded="true"] .icon-open {
		display: none;
	}
	.menu-toggle[aria-expanded="true"] .icon-close {
		display: block;
	}

	.nav-mobile {
		display: flex;
		flex-direction: column;
		gap: 0;
		padding: 0 1.5rem;
		max-height: 0;
		overflow: hidden;
		opacity: 0;
		border-top: 1px solid transparent;
		transition:
			max-height 0.28s ease,
			opacity 0.2s ease,
			padding 0.28s ease;
	}
	.nav-mobile a {
		display: block;
		text-decoration: none;
		color: var(--color-ink);
		font-weight: 600;
		font-size: 1rem;
		padding: 0.9rem 0.1rem;
		border-bottom: 1px solid var(--color-neutral-200);
	}
	.nav-mobile a:last-of-type {
		border-bottom: none;
	}
	.nav-mobile.is-open {
		max-height: 20rem;
		opacity: 1;
		padding: 0.4rem 1.5rem 1rem;
		border-top-color: var(--color-neutral-200);
	}

	@media (max-width: 720px) {
		.nav-desktop {
			display: none;
		}
		.menu-toggle {
			display: flex;
		}
	}
</style>

<script>
	function initHeaderMenu() {
		const toggle = document.getElementById("menu-toggle");
		const nav = document.getElementById("mobile-nav");
		if (!toggle || !nav) return;

		toggle.addEventListener("click", () => {
			const open = !nav.classList.contains("is-open");
			if (open) nav.hidden = false;
			toggle.setAttribute("aria-expanded", String(open));
			requestAnimationFrame(() => nav.classList.toggle("is-open", open));
			if (!open) {
				nav.addEventListener("transitionend", () => { nav.hidden = true; }, { once: true });
			}
		});

		nav.querySelectorAll("a").forEach((el) => {
			el.addEventListener("click", () => {
				nav.classList.remove("is-open");
				toggle.setAttribute("aria-expanded", "false");
				nav.addEventListener("transitionend", () => { nav.hidden = true; }, { once: true });
			});
		});
	}

	initHeaderMenu();
	document.addEventListener("astro:page-load", initHeaderMenu);
</script>
